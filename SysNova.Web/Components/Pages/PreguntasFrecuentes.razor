@page "/preguntas-frecuentes"
@using SysNova.DTO
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http

<div class="main-container py-4">
    <div class="container">
        <!-- Encabezado y Acción de Administrador -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="text-gold fw-bold m-0">Preguntas Frecuentes</h2>
                <p class="text-muted mb-0">Resuelve tus dudas más comunes</p>
            </div>
            <AuthorizeView Roles="Administrador">
                <Authorized>
                    <button class="btn btn-warning text-dark fw-bold shadow-sm" @onclick="AbrirModalCrear">
                        <i class="bi bi-plus-lg me-1"></i> Nueva Pregunta
                    </button>
                </Authorized>
            </AuthorizeView>
        </div>

        <!-- Carga de datos -->
        @if (cargando)
        {
            <div class="d-flex justify-content-center align-items-center py-5">
                <div class="spinner-border text-gold" role="status">
                    <span class="visually-hidden">Cargando preguntas...</span>
                </div>
            </div>
        }
        else if (preguntasVisibles == null || !preguntasVisibles.Any())
        {
            <div class="text-center py-5 text-muted">
                <p class="fs-5">No hay preguntas frecuentes disponibles en este momento.</p>
            </div>
        }
        else
        {
            <!-- Acordeón de Preguntas -->
            <div class="accordion accordion-flush" id="faqAccordion">
                @foreach (var faq in preguntasVisibles)
                {
                    <div class="accordion-item bg-slate-800 text-light border border-secondary mb-3 rounded-3 overflow-hidden shadow-custom">
                        <h2 class="accordion-header" id="@($"heading-{faq.PreguntaFrecuenteId}")">
                            <button class="accordion-button collapsed bg-slate-800 text-gold fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#@($"collapse-{faq.PreguntaFrecuenteId}")" aria-expanded="false" aria-controls="@($"collapse-{faq.PreguntaFrecuenteId}")">
                                @faq.Pregunta
                            </button>
                        </h2>
                        <div id="@($"collapse-{faq.PreguntaFrecuenteId}")" class="accordion-collapse collapse" aria-labelledby="@($"heading-{faq.PreguntaFrecuenteId}")" data-bs-parent="#faqAccordion">
                            <div class="accordion-body bg-slate-900 text-slate-300 border-top border-secondary">
                                <p class="m-0 mb-3">@faq.Respuesta</p>

                                <AuthorizeView Roles="Administrador">
                                    <Authorized>
                                        <div class="d-flex justify-content-end gap-2 pt-2 border-top border-secondary">
                                            <button class="btn btn-sm btn-outline-warning" @onclick="() => AbrirModalEditar(faq)">Editar</button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarPregunta(faq.PreguntaFrecuenteId)">Eliminar</button>
                                        </div>
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Modal CRUD (Administrador) -->
    @if (mostrarModal)
    {
        <div class="custom-modal-backdrop">
            <div class="custom-modal-dialog">
                <div class="modal-dark-content p-4 rounded-3 border border-secondary shadow-custom">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="modal-title text-gold fw-bold">
                            @(faqForm.PreguntaFrecuenteId == 0 ? "Nueva Pregunta" : "Editar Pregunta")
                        </h4>
                        <button type="button" class="btn-close btn-close-custom" @onclick="CerrarModal"></button>
                    </div>

                    <EditForm Model="faqForm" OnValidSubmit="GuardarPregunta">
                        <DataAnnotationsValidator />

                        <div class="custom-modal-body pe-2">
                            <div class="mb-3">
                                <label class="form-label text-light">Pregunta</label>
                                <InputText @bind-Value="faqForm.Pregunta" class="form-control input-dark" placeholder="¿Cómo realizo un pedido?" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-light">Respuesta</label>
                                <InputTextArea @bind-Value="faqForm.Respuesta" class="form-control input-dark" rows="4" placeholder="Detalle la respuesta aquí..." required />
                            </div>

                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label text-light">Orden</label>
                                    <InputNumber @bind-Value="faqForm.Orden" class="form-control input-dark" />
                                </div>
                                <div class="col-md-4 mb-3 d-flex align-items-end">
                                    <div class="form-check form-switch mb-2">
                                        <InputCheckbox @bind-Value="faqForm.Mostrar" class="form-check-input" id="checkFaqMostrar" />
                                        <label class="form-check-label text-light" for="checkFaqMostrar">Mostrar</label>
                                    </div>
                                </div>
                                <div class="col-md-4 mb-3 d-flex align-items-end">
                                    <div class="form-check form-switch mb-2">
                                        <InputCheckbox @bind-Value="faqForm.Activo" class="form-check-input" id="checkFaqActivo" />
                                        <label class="form-check-label text-light" for="checkFaqActivo">Activo</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top border-secondary">
                            <button type="button" class="btn btn-outline-light" @onclick="CerrarModal">Cancelar</button>
                            <button type="submit" class="btn btn-warning text-dark fw-bold">Guardar</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<PreguntaFrecuenteDTO> listaPreguntas = new();
    private List<PreguntaFrecuenteDTO> preguntasVisibles = new();
    private PreguntaFrecuenteDTO faqForm = new();
    private bool cargando = true;
    private bool mostrarModal = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarPreguntas();
    }

    private async Task CargarPreguntas()
    {
        cargando = true;
        try
        {
            var resultado = await Http.GetFromJsonAsync<List<PreguntaFrecuenteDTO>>("api/PreguntaFrecuente");
            if (resultado != null)
            {
                listaPreguntas = resultado;
                preguntasVisibles = listaPreguntas
                    .Where(p => p.Activo && p.Mostrar)
                    .OrderBy(p => p.Orden)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar preguntas: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirModalCrear()
    {
        faqForm = new PreguntaFrecuenteDTO
        {
            Activo = true,
            Mostrar = true,
            Orden = listaPreguntas.Count + 1,
            FechaCreacion = DateTime.Now
        };
        mostrarModal = true;
    }

    private void AbrirModalEditar(PreguntaFrecuenteDTO faq)
    {
        faqForm = new PreguntaFrecuenteDTO
        {
            PreguntaFrecuenteId = faq.PreguntaFrecuenteId,
            Pregunta = faq.Pregunta,
            Respuesta = faq.Respuesta,
            Orden = faq.Orden,
            Mostrar = faq.Mostrar,
            Activo = faq.Activo,
            FechaCreacion = faq.FechaCreacion
        };
        mostrarModal = true;
    }

    private void CerrarModal() => mostrarModal = false;

    private async Task GuardarPregunta()
    {
        try
        {
            if (faqForm.PreguntaFrecuenteId == 0)
            {
                var response = await Http.PostAsJsonAsync("api/PreguntaFrecuente", faqForm);
                if (response.IsSuccessStatusCode)
                {
                    await CargarPreguntas();
                    CerrarModal();
                }
            }
            else
            {
                faqForm.FechaModificacion = DateTime.Now;
                var response = await Http.PutAsJsonAsync("api/PreguntaFrecuente", faqForm);
                if (response.IsSuccessStatusCode)
                {
                    await CargarPreguntas();
                    CerrarModal();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al guardar pregunta: {ex.Message}");
        }
    }

    private async Task EliminarPregunta(int id)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/PreguntaFrecuente/{id}");
            if (response.IsSuccessStatusCode)
            {
                await CargarPreguntas();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al eliminar pregunta: {ex.Message}");
        }
    }
}