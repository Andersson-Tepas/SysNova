@page "/preguntas-frecuentes"
@using SysNova.DTO
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Preguntas Frecuentes - SysNova Tech</PageTitle>

<div class="container-fluid min-vh-100 p-4 main-container">

    <!-- ENCABEZADO DE LA SECCIÓN -->
    <header class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 pb-3 mb-4 border-bottom border-secondary border-opacity-25">
        <div>
            <h1 class="h2 fw-bold text-white mb-1">Preguntas Frecuentes</h1>
            <p class="text-secondary small mb-0">Gestión del centro de ayuda, dudas comunes y soporte</p>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-3">
            <!-- SIMULADOR DE ROL -->
            <div class="form-check form-switch bg-dark bg-opacity-50 p-2 px-3 rounded border border-secondary border-opacity-25 mb-0">
                <input class="form-check-input ms-0 me-2" type="checkbox" role="switch" id="switchRolFaq" @bind="esAdmin" style="cursor: pointer;" />
                <label class="form-check-label text-white small" for="switchRolFaq" style="cursor: pointer;">
                    Vista: <strong>@(esAdmin ? "👑 Administrador" : "👤 Público / Cliente")</strong>
                </label>
            </div>

            <!-- BOTÓN CREAR -->
            @if (esAdmin)
            {
                <button class="btn btn-primary d-inline-flex align-items-center gap-2 fw-semibold px-3 py-2" @onclick="AbrirModalCrear">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14" /></svg>
                    Nueva Pregunta
                </button>
            }
        </div>
    </header>

    <!-- BARRA DE ACCIÓN / ESTADÍSTICAS ADMIN -->
    @if (esAdmin)
    {
        <div class="card bg-dark bg-opacity-50 border-secondary border-opacity-25 mb-4 text-white">
            <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2 py-2 px-3">
                <h6 class="mb-0 text-white-50">Panel de Control de Preguntas Frecuentes</h6>
                <div class="small">
                    Total preguntas: <strong class="text-info">@listaPreguntas.Count</strong>
                    <span class="mx-2 text-secondary">|</span>
                    Visibles: <strong class="text-success">@listaPreguntas.Count(p => p.Mostrar && p.Activo)</strong>
                </div>
            </div>
        </div>
    }

    <!-- LAYOUT PRINCIPAL (FILTROS Y PREGUNTAS) -->
    <div class="row g-4">

        <!-- SIDEBAR FILTROS -->
        <aside class="col-12 col-lg-3">
            <div class="card bg-dark bg-opacity-50 border-secondary border-opacity-25 text-white p-3 mb-3">
                <h6 class="text-uppercase text-secondary fw-bold fs-7 mb-3">Búsqueda</h6>
                <input type="text" class="form-control input-dark" placeholder="Buscar en pregunta o respuesta..." @bind="busquedaTexto" @bind:event="oninput" />
            </div>

            <div class="card bg-dark bg-opacity-50 border-secondary border-opacity-25 text-white p-3 mb-3">
                <h6 class="text-uppercase text-secondary fw-bold fs-7 mb-3">Filtros Rápidos</h6>
                <div class="d-flex flex-column gap-2">
                    <div class="form-check">
                        <input class="form-check-input input-dark" type="checkbox" id="chkFavoritosFaq" @bind="soloFavoritos" />
                        <label class="form-check-label small" for="chkFavoritosFaq">Guardadas (❤️ @idsFavoritos.Count)</label>
                    </div>
                </div>
            </div>

            <button class="btn btn-outline-secondary w-100 btn-sm text-white" @onclick="LimpiarFiltros">Limpiar Filtros</button>
        </aside>

        <!-- MAIN DE PREGUNTAS FRECUENTES -->
        <main class="col-12 col-lg-9">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 pb-3 mb-3 border-bottom border-secondary border-opacity-25">
                <span class="text-secondary small">Mostrando <strong class="text-white">@PreguntasFiltradas.Count()</strong> preguntas</span>

                <div class="d-flex align-items-center gap-2">
                    <label class="small text-secondary mb-0 text-nowrap">Ordenar por:</label>
                    <select class="form-select form-select-sm input-dark w-auto" @bind="criterioOrden">
                        <option value="orden">Orden de prioridad</option>
                        <option value="pregunta">Pregunta A-Z</option>
                        <option value="recientes">Más recientes</option>
                    </select>
                </div>
            </div>

            @if (cargando)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary mb-3" role="status"></div>
                    <p class="text-secondary mb-0">Cargando preguntas frecuentes...</p>
                </div>
            }
            else if (!PreguntasFiltradas.Any())
            {
                <div class="text-center py-5 card bg-dark bg-opacity-25 border-secondary border-opacity-25">
                    <p class="fs-5 mb-3">🔍 No se encontraron preguntas con los criterios seleccionados.</p>
                    <div>
                        <button class="btn btn-outline-primary btn-sm" @onclick="LimpiarFiltros">Restablecer filtros</button>
                    </div>
                </div>
            }
            else
            {
                <div class="accordion d-flex flex-column gap-3" id="accordionFaq">
                    @foreach (var item in PreguntasFiltradas)
                    {
                        var esFav = idsFavoritos.Contains(item.PreguntaFrecuenteId);
                        var collapseId = $"faq-collapse-{item.PreguntaFrecuenteId}";

                        <div class="card border-secondary border-opacity-25 bg-dark bg-opacity-50 shadow-sm text-white overflow-hidden" style="opacity: @(!item.Activo || !item.Mostrar ? "0.6" : "1");">

                            <!-- ENCABEZADO DE PREGUNTA -->
                            <div class="card-header border-bottom-0 bg-transparent p-3 d-flex align-items-center justify-content-between gap-3 position-relative">

                                <div class="d-flex align-items-center gap-3 flex-grow-1 overflow-hidden">
                                    <button class="btn btn-link text-decoration-none text-white fw-semibold text-start p-0 flex-grow-1 d-flex align-items-center gap-2"
                                            type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#@collapseId"
                                            aria-expanded="false"
                                            aria-controls="@collapseId">
                                        <span class="text-primary fs-5">❓</span>
                                        <span class="text-truncate fs-6">@item.Pregunta</span>
                                    </button>
                                </div>

                                <!-- BADGES Y ACCIONES -->
                                <div class="d-flex align-items-center gap-2 ms-auto flex-shrink-0">
                                    <span class="badge bg-dark border border-secondary text-info">#@item.Orden</span>

                                    @if (!item.Activo)
                                    {
                                        <span class="badge bg-secondary">INACTIVA</span>
                                    }
                                    @if (!item.Mostrar)
                                    {
                                        <span class="badge bg-warning text-dark">OCULTA</span>
                                    }

                                    <!-- BOTÓN FAVORITO -->
                                    <button type="button"
                                            class="btn btn-sm btn-dark rounded-circle p-1 d-flex align-items-center justify-content-center border border-secondary border-opacity-50 ms-1"
                                            style="width: 32px; height: 32px;"
                                            @onclick="() => ToggleFavorito(item.PreguntaFrecuenteId)"
                                            title="@(esFav ? "Quitar de guardados" : "Guardar pregunta")">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="@(esFav ? "#dc3545" : "none")" stroke="@(esFav ? "#dc3545" : "currentColor")" stroke-width="2">
                                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                                        </svg>
                                    </button>

                                    @if (esAdmin)
                                    {
                                        <button class="btn btn-sm btn-outline-warning py-0 px-2 ms-1" @onclick="() => AbrirModalEditar(item)">✏️</button>
                                        <button class="btn btn-sm btn-outline-danger py-0 px-2" @onclick="() => EliminarPregunta(item.PreguntaFrecuenteId)">🗑️</button>
                                    }
                                </div>
                            </div>

                            <!-- CONTENIDO DE RESPUESTA -->
                            <div id="@collapseId" class="collapse" data-bs-parent="#accordionFaq">
                                <div class="card-body border-top border-secondary border-opacity-25 bg-black bg-opacity-25 p-3 text-white-50">
                                    <p class="mb-2 text-white style-whitespace-pre-line">@item.Respuesta</p>
                                    <div class="d-flex justify-content-end align-items-center pt-2 border-top border-secondary border-opacity-10">
                                        <small class="text-secondary fs-7">📅 Registrada el @item.FechaCreacion.ToString("dd MMM yyyy")</small>
                                    </div>
                                </div>
                            </div>

                        </div>
                    }
                </div>
            }
        </main>
    </div>
</div>

<!-- MODAL FORMULARIO ADMIN (CREAR / EDITAR) -->
@if (mostrarModal)
{
    <div class="custom-modal-backdrop">
        <div class="custom-modal-dialog">
            <div class="modal-content border-secondary border-opacity-25 shadow-lg text-white modal-dark-content">

                <div class="modal-header border-secondary border-opacity-25 pb-3">
                    <h5 class="modal-title text-white">@(esEdicion ? "Editar Pregunta Frecuente" : "Nueva Pregunta Frecuente")</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>

                <EditForm Model="@formModel" OnValidSubmit="GuardarPregunta">
                    <DataAnnotationsValidator />

                    <div class="modal-body py-3">
                        <div class="mb-3">
                            <label class="form-label small text-secondary">Pregunta</label>
                            <InputText class="form-control input-dark" @bind-Value="formModel.Pregunta" placeholder="Ej: ¿Cuáles son los métodos de pago aceptados?" />
                            <ValidationMessage For="@(() => formModel.Pregunta)" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small text-secondary">Respuesta Detallada</label>
                            <InputTextArea class="form-control input-dark" rows="5" @bind-Value="formModel.Respuesta" placeholder="Escribe la respuesta detallada aquí..." />
                            <ValidationMessage For="@(() => formModel.Respuesta)" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small text-secondary">Orden de Visualización</label>
                            <InputNumber class="form-control input-dark" @bind-Value="formModel.Orden" min="0" />
                        </div>

                        <div class="d-flex flex-wrap gap-4 pt-2">
                            <div class="form-check form-switch">
                                <InputCheckbox class="form-check-input" type="checkbox" role="switch" @bind-Value="formModel.Mostrar" id="chkMostrarFaq" />
                                <label class="form-check-label small" for="chkMostrarFaq">Visible en Web</label>
                            </div>
                            <div class="form-check form-switch ms-auto">
                                <InputCheckbox class="form-check-input" type="checkbox" role="switch" @bind-Value="formModel.Activo" id="chkActivoFaq" />
                                <label class="form-check-label small" for="chkActivoFaq">Activa</label>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer border-secondary border-opacity-25 pt-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CerrarModal">Cancelar</button>
                        <button type="submit" class="btn btn-primary btn-sm px-3" disabled="@guardando">
                            @(guardando ? "Guardando..." : "Guardar")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<PreguntaFrecuenteDTO> listaPreguntas = new();
    private PreguntaFrecuenteDTO formModel = new();
    private HashSet<int> idsFavoritos = new();

    private bool esAdmin = true;
    private bool cargando = true;
    private bool guardando = false;
    private bool mostrarModal = false;
    private bool esEdicion = false;

    // FILTROS
    private string busquedaTexto = "";
    private bool soloFavoritos = false;
    private string criterioOrden = "orden";

    protected override async Task OnInitializedAsync()
    {
        await CargarPreguntas();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CargarFavoritos();
            await VerificarRol();
            StateHasChanged();
        }
    }

    private async Task AplicarTokenAutorizacion()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
            if (!string.IsNullOrEmpty(token))
            {
                Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al obtener token: {ex.Message}");
        }
    }

    private async Task VerificarRol()
    {
        try
        {
            var rol = await JS.InvokeAsync<string>("localStorage.getItem", "userRol");
            var correo = await JS.InvokeAsync<string>("localStorage.getItem", "userEmail");

            if (!string.IsNullOrEmpty(rol))
            {
                esAdmin = rol.Equals("Administrador", StringComparison.OrdinalIgnoreCase);
            }
            else if (!string.IsNullOrEmpty(correo))
            {
                esAdmin = correo.Equals("admin@sysnova.com", StringComparison.OrdinalIgnoreCase);
            }
        }
        catch { }
    }

    private async Task CargarFavoritos()
    {
        try
        {
            var favsJson = await JS.InvokeAsync<string>("localStorage.getItem", "sysnova_faq_favoritos");
            if (!string.IsNullOrEmpty(favsJson))
            {
                var lista = System.Text.Json.JsonSerializer.Deserialize<List<int>>(favsJson);
                if (lista != null) idsFavoritos = new HashSet<int>(lista);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar favoritos: {ex.Message}");
        }
    }

    private async Task ToggleFavorito(int id)
    {
        if (idsFavoritos.Contains(id))
            idsFavoritos.Remove(id);
        else
            idsFavoritos.Add(id);

        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(idsFavoritos);
            await JS.InvokeVoidAsync("localStorage.setItem", "sysnova_faq_favoritos", json);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al guardar favorito: {ex.Message}");
        }
    }

    private async Task CargarPreguntas()
    {
        cargando = true;
        try
        {
            await AplicarTokenAutorizacion();
            var res = await Http.GetFromJsonAsync<List<PreguntaFrecuenteDTO>>("api/preguntafrecuente");
            if (res != null) listaPreguntas = res;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al consultar API: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }

    private IEnumerable<PreguntaFrecuenteDTO> PreguntasFiltradas
    {
        get
        {
            var res = listaPreguntas.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(busquedaTexto))
            {
                res = res.Where(p => (p.Pregunta != null && p.Pregunta.Contains(busquedaTexto, StringComparison.OrdinalIgnoreCase)) ||
                                     (p.Respuesta != null && p.Respuesta.Contains(busquedaTexto, StringComparison.OrdinalIgnoreCase)));
            }

            if (soloFavoritos) res = res.Where(p => idsFavoritos.Contains(p.PreguntaFrecuenteId));

            return criterioOrden switch
            {
                "pregunta" => res.OrderBy(p => p.Pregunta),
                "recientes" => res.OrderByDescending(p => p.FechaCreacion),
                _ => res.OrderBy(p => p.Orden)
            };
        }
    }

    private void LimpiarFiltros()
    {
        busquedaTexto = "";
        soloFavoritos = false;
        criterioOrden = "orden";
    }

    private async Task BloquearScrollFondo(bool bloquear)
    {
        try
        {
            var style = bloquear ? "hidden" : "auto";
            await JS.InvokeVoidAsync("eval", $"document.body.style.overflow = '{style}'");
        }
        catch { }
    }

    private async Task AbrirModalCrear()
    {
        formModel = new PreguntaFrecuenteDTO
        {
            Activo = true,
            Mostrar = true,
            Orden = 1,
            FechaCreacion = DateTime.Now
        };
        esEdicion = false;
        mostrarModal = true;
        await BloquearScrollFondo(true);
    }

    private async Task AbrirModalEditar(PreguntaFrecuenteDTO item)
    {
        formModel = new PreguntaFrecuenteDTO
        {
            PreguntaFrecuenteId = item.PreguntaFrecuenteId,
            Pregunta = item.Pregunta,
            Respuesta = item.Respuesta,
            Orden = item.Orden,
            Mostrar = item.Mostrar,
            Activo = item.Activo,
            FechaCreacion = item.FechaCreacion,
            FechaModificacion = DateTime.Now
        };
        esEdicion = true;
        mostrarModal = true;
        await BloquearScrollFondo(true);
    }

    private async Task CerrarModal()
    {
        mostrarModal = false;
        await BloquearScrollFondo(false);
    }

    private async Task GuardarPregunta()
    {
        guardando = true;
        try
        {
            await AplicarTokenAutorizacion();
            HttpResponseMessage response;

            if (esEdicion)
            {
                formModel.FechaModificacion = DateTime.Now;
                response = await Http.PutAsJsonAsync("api/preguntafrecuente", formModel);
            }
            else
            {
                formModel.FechaCreacion = DateTime.Now;
                response = await Http.PostAsJsonAsync("api/preguntafrecuente", formModel);
            }

            if (response.IsSuccessStatusCode)
            {
                await CerrarModal();
                await CargarPreguntas();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", $"Error al guardar ({response.StatusCode}).");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error de conexión: {ex.Message}");
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task EliminarPregunta(int id)
    {
        bool confirmado = await JS.InvokeAsync<bool>("confirm", "¿Estás seguro de eliminar esta pregunta frecuente?");
        if (!confirmado) return;

        try
        {
            await AplicarTokenAutorizacion();
            var response = await Http.DeleteAsync($"api/preguntafrecuente/{id}");

            if (response.IsSuccessStatusCode)
            {
                await CargarPreguntas();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", $"No se pudo eliminar la pregunta. Código: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al eliminar: {ex.Message}");
        }
    }
}