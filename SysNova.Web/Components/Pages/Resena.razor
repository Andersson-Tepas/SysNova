@namespace SysNova.Web.Components.Pages

@using System.Text
@using System.Text.Json
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using SysNova.DTO
@using SysNova.Web.Services

@inject HttpClient Http
@inject IJSRuntime JS
@inject AuthStateService AuthState


@if (mostrarModal)
{
    <div class="custom-modal-backdrop"
         style="position:fixed; inset:0; z-index:99999; display:flex; align-items:center; justify-content:center; padding:1rem; background:rgba(0,0,0,.78); backdrop-filter:blur(6px);"
         @onclick="CerrarModal">

        <div class="custom-modal-dialog"
             style="width:min(620px, 96vw); max-height:92vh; overflow:auto;"
             @onclick:stopPropagation="true">

            <div class="modal-content border-secondary border-opacity-25 shadow-lg text-white modal-dark-content"
                 style="background:#111827; border-radius:16px;">

                <div class="modal-header border-secondary border-opacity-25 pb-3">

                    <div>
                        <h5 class="modal-title text-white mb-1">
                            @(esEdicion ? "Editar mi reseña" : "Agregar reseña")
                        </h5>

                        <p class="text-secondary small mb-0">
                            Comparte tu experiencia con un producto.
                        </p>
                    </div>

                    <button type="button"
                            class="btn-close btn-close-white"
                            @onclick="CerrarModal">
                    </button>

                </div>


                @if (cargando)
                {
                    <div class="modal-body py-5 text-center">

                        <div class="spinner-border text-primary mb-3"
                             role="status">
                        </div>

                        <p class="text-secondary mb-0">
                            Cargando tus reseñas...
                        </p>

                    </div>
                }
                else
                {
                    <EditForm Model="@formModel"
                              OnValidSubmit="GuardarResena">

                        <DataAnnotationsValidator />

                        <div class="modal-body py-3 custom-modal-body">

                            @if (misResenas.Any())
                            {
                                <div class="mb-3">

                                    <label class="form-label small text-secondary">
                                        Mis reseñas
                                    </label>

                                    <select class="form-select input-dark"
                                            value="@resenaSeleccionadaId"
                                            @onchange="SeleccionarResena">

                                        <option value="0">
                                            + Crear una nueva reseña
                                        </option>

                                        @foreach (var item in misResenas)
                                        {
                                            <option value="@item.ResenaId">
                                                @ObtenerNombreProducto(item.ProductoId)
                                                · @item.Calificacion ★
                                            </option>
                                        }

                                    </select>

                                    <small class="text-secondary d-block mt-1">
                                        Solo puedes editar reseñas creadas por tu cuenta.
                                    </small>

                                </div>
                            }


                            <div class="mb-3">

                                <label class="form-label small text-secondary">
                                    Producto
                                </label>

                                <InputSelect class="form-select input-dark"
                                             @bind-Value="formModel.ProductoId"
                                             disabled="@esEdicion">

                                    <option value="0">
                                        Seleccionar producto...
                                    </option>

                                    @foreach (var producto in Productos.Where(p => p.Activo))
                                    {
                                        <option value="@producto.ProductoId">
                                            @producto.Nombre
                                        </option>
                                    }

                                </InputSelect>

                            </div>


                            <div class="mb-3">

                                <label class="form-label small text-secondary">
                                    Calificación
                                </label>

                                <div class="resena-stars-selector">

                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        var estrella = i;

                                        <button type="button"
                                                class="resena-star-button @(estrella <= formModel.Calificacion ? "active" : "")"
                                                @onclick="() => SeleccionarCalificacion(estrella)"
                                                title="@($"{estrella} estrella{(estrella == 1 ? "" : "s")}")"
                                                aria-label="@($"{estrella} estrella{(estrella == 1 ? "" : "s")}")">
                                            ★
                                        </button>
                                    }

                                    <span class="resena-rating-text">
                                        @formModel.Calificacion de 5
                                    </span>

                                </div>

                            </div>


                            <div class="mb-3">

                                <label class="form-label small text-secondary">
                                    Comentario
                                </label>

                                <InputTextArea class="form-control input-dark"
                                               rows="4"
                                               @bind-Value="formModel.Comentario"
                                               placeholder="¿Qué opinas de este producto?" />

                                <ValidationMessage For="@(() => formModel.Comentario)"
                                                   class="text-danger small" />

                            </div>


                            @if (!string.IsNullOrWhiteSpace(mensajeError))
                            {
                                <div class="alert alert-danger py-2 mb-0">
                                    @mensajeError
                                </div>
                            }

                        </div>


                        <div class="modal-footer border-secondary border-opacity-25 pt-2">

                            @if (esEdicion)
                            {
                                <button type="button"
                                        class="btn btn-outline-info btn-sm me-auto"
                                        @onclick="NuevaResena">
                                    + Nueva reseña
                                </button>
                            }

                    <button type="button"
                            class="btn btn-outline-secondary btn-sm"
                            @onclick="CerrarModal">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn btn-primary btn-sm px-3"
                            disabled="@guardando">

                        @(guardando
                                                ? "Guardando..."
                                                : esEdicion
                                                ? "Guardar cambios"
                                                : "Publicar reseña")

                    </button>

                        </div>

                    </EditForm>
                        }

            </div>

        </div>

    </div>
}


@code {

    [Parameter]
    public IReadOnlyList<ProductoDTO> Productos { get; set; }
        = Array.Empty<ProductoDTO>();

    [Parameter]
    public EventCallback OnResenaGuardada { get; set; }


    private bool mostrarModal = false;
    private bool cargando = false;
    private bool guardando = false;
    private bool esEdicion = false;

    private int resenaSeleccionadaId = 0;
    private int clienteIdActual = 0;

    private string mensajeError = string.Empty;

    private List<ResenaDTO> misResenas = new();

    private ResenaDTO formModel = new();


    // =========================================================
    // ESTE MÉTODO LO INVOCA INICIO.RAZOR MEDIANTE @ref
    // =========================================================
    public async Task AbrirAsync()
    {
        mostrarModal = true;
        cargando = true;
        guardando = false;
        mensajeError = string.Empty;

        // Renderizamos el modal inmediatamente.
        await InvokeAsync(StateHasChanged);

        try
        {
            await AuthState.InicializarAsync();

            if (!AuthState.EsCliente)
            {
                mensajeError =
                    "Debes iniciar sesión como cliente para escribir una reseña.";
                return;
            }

            clienteIdActual =
                await ObtenerClienteIdDesdeToken();

            if (clienteIdActual <= 0)
            {
                mensajeError =
                    "No se pudo identificar tu cuenta de cliente.";
                return;
            }

            await AplicarTokenAutorizacion();

            await CargarMisResenas();

            NuevaResena();
        }
        catch (Exception ex)
        {
            mensajeError =
                $"No se pudo cargar el formulario: {ex.Message}";
        }
        finally
        {
            cargando = false;

            await InvokeAsync(StateHasChanged);
        }
    }


    public async Task AbrirEditarAsync(
        int resenaId)
    {
        mostrarModal = true;
        cargando = true;
        guardando = false;
        mensajeError = string.Empty;

        await InvokeAsync(StateHasChanged);

        try
        {
            await AuthState.InicializarAsync();

            if (!AuthState.EsCliente)
            {
                mensajeError =
                    "Debes iniciar sesión como cliente para editar una reseña.";
                return;
            }

            clienteIdActual =
                await ObtenerClienteIdDesdeToken();

            if (clienteIdActual <= 0)
            {
                mensajeError =
                    "No se pudo identificar tu cuenta de cliente.";
                return;
            }

            await AplicarTokenAutorizacion();

            await CargarMisResenas();

            var item =
                misResenas.FirstOrDefault(
                    r => r.ResenaId == resenaId);

            if (item == null)
            {
                mensajeError =
                    "No puedes editar esta reseña.";
                return;
            }

            esEdicion = true;
            resenaSeleccionadaId = item.ResenaId;

            formModel =
                new ResenaDTO
                {
                    ResenaId = item.ResenaId,
                    ClienteId = item.ClienteId,
                    ProductoId = item.ProductoId,
                    Calificacion = item.Calificacion,
                    Comentario = item.Comentario,
                    Fecha = item.Fecha,
                    Activo = item.Activo,
                    FechaCreacion = item.FechaCreacion,
                    FechaModificacion = item.FechaModificacion
                };
        }
        catch (Exception ex)
        {
            mensajeError =
                $"No se pudo abrir la reseña: {ex.Message}";
        }
        finally
        {
            cargando = false;

            await InvokeAsync(StateHasChanged);
        }
    }


    public async Task EliminarAsync(
        int resenaId)
    {
        await AuthState.InicializarAsync();

        if (!AuthState.EsCliente)
            return;

        clienteIdActual =
            await ObtenerClienteIdDesdeToken();

        if (clienteIdActual <= 0)
            return;

        await AplicarTokenAutorizacion();

        await CargarMisResenas();

        var item =
            misResenas.FirstOrDefault(
                r => r.ResenaId == resenaId);

        if (item == null)
            return;

        var confirmado =
            await JS.InvokeAsync<bool>(
                "confirm",
                "¿Deseas eliminar tu reseña? Esta acción no se puede deshacer.");

        if (!confirmado)
            return;

        try
        {
            var response =
                await Http.DeleteAsync(
                    $"api/resena/{resenaId}");

            if (!response.IsSuccessStatusCode)
            {
                var detalle =
                    await response.Content
                        .ReadAsStringAsync();

                await JS.InvokeVoidAsync(
                    "alert",
                    $"No se pudo eliminar la reseña ({response.StatusCode}). {detalle}");

                return;
            }

            await CargarMisResenas();

            if (OnResenaGuardada.HasDelegate)
            {
                await OnResenaGuardada.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync(
                "alert",
                $"Error al eliminar la reseña: {ex.Message}");
        }
    }


    private async Task CerrarModal()
    {
        mostrarModal = false;
        cargando = false;
        guardando = false;
        mensajeError = string.Empty;

        await InvokeAsync(StateHasChanged);
    }


    private async Task CargarMisResenas()
    {
        var todas =
            await Http.GetFromJsonAsync<List<ResenaDTO>>(
                "api/resena");

        misResenas =
            todas?
                .Where(r =>
                    r.ClienteId == clienteIdActual)
                .OrderByDescending(r => r.Fecha)
                .ToList()
            ?? new List<ResenaDTO>();
    }


    private void NuevaResena()
    {
        esEdicion = false;
        resenaSeleccionadaId = 0;
        mensajeError = string.Empty;

        formModel =
            new ResenaDTO
            {
                ClienteId = clienteIdActual,
                ProductoId = 0,
                Calificacion = (byte)5,
                Comentario = string.Empty,
                Fecha = DateTime.Now,
                FechaCreacion = DateTime.Now,
                Activo = true
            };
    }


    private void SeleccionarResena(
        ChangeEventArgs e)
    {
        if (!int.TryParse(
            e.Value?.ToString(),
            out var id))
        {
            id = 0;
        }

        if (id <= 0)
        {
            NuevaResena();
            return;
        }

        var item =
            misResenas.FirstOrDefault(
                r => r.ResenaId == id);

        if (item == null)
        {
            NuevaResena();
            return;
        }

        esEdicion = true;
        resenaSeleccionadaId = item.ResenaId;
        mensajeError = string.Empty;

        formModel =
            new ResenaDTO
            {
                ResenaId = item.ResenaId,
                ClienteId = item.ClienteId,
                ProductoId = item.ProductoId,
                Calificacion = item.Calificacion,
                Comentario = item.Comentario,
                Fecha = item.Fecha,
                Activo = item.Activo,
                FechaCreacion = item.FechaCreacion,
                FechaModificacion = item.FechaModificacion
            };
    }


    private void SeleccionarCalificacion(
        int calificacion)
    {
        formModel.Calificacion =
            (byte)Math.Clamp(
                calificacion,
                1,
                5);
    }


    private async Task GuardarResena()
    {
        if (!AuthState.EsCliente ||
            clienteIdActual <= 0)
        {
            mensajeError =
                "No se pudo validar la sesión del cliente.";
            return;
        }

        if (formModel.ProductoId <= 0)
        {
            mensajeError =
                "Selecciona un producto.";
            return;
        }

        if (string.IsNullOrWhiteSpace(
            formModel.Comentario))
        {
            mensajeError =
                "Escribe un comentario.";
            return;
        }

        guardando = true;
        mensajeError = string.Empty;

        try
        {
            await AplicarTokenAutorizacion();

            HttpResponseMessage response;

            if (esEdicion)
            {
                var perteneceAlCliente =
                    misResenas.Any(
                        r =>
                            r.ResenaId ==
                            formModel.ResenaId &&
                            r.ClienteId ==
                            clienteIdActual);

                if (!perteneceAlCliente)
                {
                    mensajeError =
                        "No puedes editar una reseña que no te pertenece.";
                    return;
                }

                formModel.ClienteId =
                    clienteIdActual;

                formModel.FechaModificacion =
                    DateTime.Now;

                response =
                    await Http.PutAsJsonAsync(
                        "api/resena",
                        formModel);
            }
            else
            {
                var yaExiste =
                    misResenas.Any(
                        r =>
                            r.ProductoId ==
                            formModel.ProductoId);

                if (yaExiste)
                {
                    mensajeError =
                        "Ya tienes una reseña para ese producto. Selecciónala arriba para editarla.";
                    return;
                }

                formModel.ResenaId = 0;
                formModel.ClienteId = clienteIdActual;
                formModel.Fecha = DateTime.Now;
                formModel.FechaCreacion = DateTime.Now;
                formModel.Activo = true;

                response =
                    await Http.PostAsJsonAsync(
                        "api/resena",
                        formModel);
            }

            if (!response.IsSuccessStatusCode)
            {
                var detalle =
                    await response.Content
                        .ReadAsStringAsync();

                mensajeError =
                    $"No se pudo guardar la reseña ({response.StatusCode}). {detalle}";
                return;
            }

            await CargarMisResenas();

            if (OnResenaGuardada.HasDelegate)
            {
                await OnResenaGuardada.InvokeAsync();
            }

            await CerrarModal();
        }
        catch (Exception ex)
        {
            mensajeError =
                $"Error de conexión: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }


    private string ObtenerNombreProducto(
        int productoId)
    {
        return Productos
            .FirstOrDefault(
                p => p.ProductoId == productoId)
            ?.Nombre
            ?? "Producto";
    }


    private async Task AplicarTokenAutorizacion()
    {
        var token =
            await JS.InvokeAsync<string?>(
                "localStorage.getItem",
                "authToken");

        if (string.IsNullOrWhiteSpace(token))
        {
            Http.DefaultRequestHeaders.Authorization = null;
            return;
        }

        Http.DefaultRequestHeaders.Authorization =
            new System.Net.Http.Headers.AuthenticationHeaderValue(
                "Bearer",
                token);
    }


    private async Task<int> ObtenerClienteIdDesdeToken()
    {
        var token =
            await JS.InvokeAsync<string?>(
                "localStorage.getItem",
                "authToken");

        if (string.IsNullOrWhiteSpace(token))
            return 0;

        try
        {
            var partes =
                token.Split('.');

            if (partes.Length != 3)
                return 0;

            var payload =
                partes[1]
                    .Replace('-', '+')
                    .Replace('_', '/');

            switch (payload.Length % 4)
            {
                case 2:
                    payload += "==";
                    break;

                case 3:
                    payload += "=";
                    break;
            }

            var bytes =
                Convert.FromBase64String(
                    payload);

            var json =
                Encoding.UTF8.GetString(
                    bytes);

            using var documento =
                JsonDocument.Parse(
                    json);

            var root =
                documento.RootElement;

            var idTexto =
                ObtenerClaim(
                    root,
                    "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier")
                ?? ObtenerClaim(
                    root,
                    "nameid")
                ?? ObtenerClaim(
                    root,
                    "sub");

            return int.TryParse(
                idTexto,
                out var id)
                    ? id
                    : 0;
        }
        catch
        {
            return 0;
        }
    }


    private static string? ObtenerClaim(
        JsonElement root,
        string nombre)
    {
        if (!root.TryGetProperty(
            nombre,
            out var valor))
        {
            return null;
        }

        if (valor.ValueKind ==
            JsonValueKind.String)
        {
            return valor.GetString();
        }

        if (valor.ValueKind ==
            JsonValueKind.Number)
        {
            return valor.GetRawText();
        }

        return null;
    }
}
