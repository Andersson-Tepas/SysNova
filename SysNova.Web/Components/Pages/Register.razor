@page "/register"
@layout AuthLayout
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IConfiguration Configuration
@inject AuthStateService AuthState
@using SysNova.DTO
@using SysNova.Web.Services
@using Microsoft.JSInterop
@implements IAsyncDisposable

<div class="auth-page">
    <div class="auth-card auth-card-register">

        <section class="auth-brand-panel">
            <div class="brand-logo">
                <div class="brand-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M13.2 2 5 13h5.8L9.8 22 19 10.2h-6.1L13.2 2Z" />
                    </svg>
                </div>
                <span>NEXO<span>Tech</span></span>
            </div>

            <div class="brand-content">
                <div class="brand-eyebrow">TU TECNOLOGÍA, MÁS CERCA</div>
                <h1>Todo lo que necesitas<br />para avanzar.</h1>
                <p>
                    Crea tu espacio NEXO y disfruta una experiencia
                    de compra diseñada para ti.
                </p>
            </div>

            <div class="brand-benefits">
                <div class="benefit">
                    <div class="benefit-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>
                    </div>
                    <span>Seguimiento de tus pedidos en tiempo real</span>
                </div>

                <div class="benefit">
                    <div class="benefit-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>
                    </div>
                    <span>Ofertas exclusivas para miembros NEXO</span>
                </div>

                <div class="benefit">
                    <div class="benefit-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>
                    </div>
                    <span>Soporte experto cuando lo necesites</span>
                </div>
            </div>

            <div class="decor-circle decor-circle-top"></div>
            <div class="decor-circle decor-circle-bottom"></div>
        </section>

        <section class="auth-form-panel">
            <div class="auth-form-container register-container">

                <div class="mobile-brand-logo">
                    <div class="brand-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M13.2 2 5 13h5.8L9.8 22 19 10.2h-6.1L13.2 2Z" />
                        </svg>
                    </div>
                    <span>NEXO<span>Tech</span></span>
                </div>

                <div class="form-eyebrow">ÚNETE A NEXO</div>
                <h2>Crea tu cuenta</h2>

                <p class="form-description">
                    Guarda tus favoritos y recibe beneficios exclusivos.
                </p>

                @if (!string.IsNullOrEmpty(mensajeError))
                {
                    <div class="auth-message auth-message-error">
                        @mensajeError
                    </div>
                }

                <!-- GOOGLE - BOTÓN REAL DEL DISEÑO -->
                <div class="nexo-google-shell">
                    <button type="button"
                            class="nexo-google-visual nexo-google-action"
                            @onclick="IniciarGoogle"
                            disabled="@cargando">

                        <svg class="nexo-google-logo" viewBox="0 0 48 48" aria-hidden="true">
                            <path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303C33.655 32.657 29.203 36 24 36c-6.627 0-12-5.373-12-12S17.373 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.277 4 24 4 12.955 4 4 12.955 4 24s8.955 20 20 20 20-8.955 20-20c0-1.341-.138-2.65-.389-3.917z" />
                            <path fill="#FF3D00" d="M6.306 14.691l6.571 4.819C14.655 16.108 18.961 13 24 13c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.277 4 24 4c-7.682 0-14.347 4.337-17.694 10.691z" />
                            <path fill="#4CAF50" d="M24 44c5.176 0 9.86-1.977 13.409-5.192l-6.19-5.238C29.143 35.091 26.671 36 24 36c-5.182 0-9.625-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z" />
                            <path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303c-1.058 3.091-3.287 5.531-6.084 6.968l.003-.002 6.19 5.238C33.971 41.091 44 36 44 24c0-1.341-.138-2.65-.389-3.917z" />
                        </svg>

                        <span>Registrarme con Google</span>
                    </button>
                </div>

                <div class="auth-divider">
                    <span>O CONTINÚA CON TU CORREO</span>
                </div>

                <EditForm Model="registerModel"
                          OnValidSubmit="ProcesarRegistro"
                          class="auth-form register-form">

                    <DataAnnotationsValidator />

                    <div class="form-group">
                        <label for="register-name">Nombre completo</label>

                        <div class="input-wrapper">
                            <svg class="input-icon" viewBox="0 0 24 24" aria-hidden="true">
                                <circle cx="12" cy="8" r="3.5" />
                                <path d="M5 20a7 7 0 0 1 14 0" />
                            </svg>

                            <InputText id="register-name"
                                       type="text"
                                       @bind-Value="nombreCompleto"
                                       placeholder="Tu nombre"
                                       autocomplete="name"
                                       required />
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="register-email">Correo electrónico</label>

                        <div class="input-wrapper">
                            <svg class="input-icon" viewBox="0 0 24 24" aria-hidden="true">
                                <rect x="3" y="5" width="18" height="14" rx="2" />
                                <path d="m3 7 9 6 9-6" />
                            </svg>

                            <InputText id="register-email"
                                       type="email"
                                       @bind-Value="registerModel.Correo"
                                       placeholder="tu@email.com"
                                       autocomplete="email"
                                       required />
                        </div>

                        <ValidationMessage For="@(() => registerModel.Correo)" />
                    </div>

                    <div class="form-group">
                        <label for="register-password">Contraseña</label>

                        <div class="input-wrapper">
                            <svg class="input-icon" viewBox="0 0 24 24" aria-hidden="true">
                                <rect x="5" y="10" width="14" height="10" rx="2" />
                                <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                                <circle cx="12" cy="15" r="1" />
                            </svg>

                            <input id="register-password"
                                   type="@tipoPassword"
                                   @bind="registerModel.Password"
                                   @bind:event="oninput"
                                   placeholder="Mínimo 8 caracteres"
                                   autocomplete="new-password"
                                   required />

                            <button type="button"
                                    class="password-toggle"
                                    @onclick="TogglePassword">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" />
                                    <circle cx="12" cy="12" r="2.5" />
                                </svg>
                            </button>
                        </div>

                        <ValidationMessage For="@(() => registerModel.Password)" />
                    </div>

                    <div class="terms-option">
                        <label>
                            <input type="checkbox"
                                   @bind="terminosAceptados" />

                            <span>
                                Acepto los <a href="/terms">términos de uso</a>
                                y la <a href="/privacy">política de privacidad</a>
                                de NEXO Tech.
                            </span>
                        </label>
                    </div>

                    <button type="submit"
                            class="auth-button"
                            disabled="@cargando">

                        <span>@(cargando ? "Creando..." : "Crear mi cuenta")</span>

                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M5 12h14" />
                            <path d="m13 6 6 6-6 6" />
                        </svg>
                    </button>
                </EditForm>

                <div class="auth-switch register-switch">
                    <span>¿Ya tienes una cuenta?</span>
                    <a href="/login">Inicia sesión</a>
                </div>
            </div>
        </section>
    </div>
</div>


@if (mostrarModalExito)
{
    <div class="register-success-backdrop">
        <div class="register-success-modal">

            <div class="register-success-icon">✓</div>

            <div class="register-success-eyebrow">
                REGISTRO COMPLETADO
            </div>

            <h3>¡Cuenta creada correctamente!</h3>

            <p>
                Tu cuenta NEXO Tech ya está lista.
                Te llevaremos al inicio de sesión.
            </p>

        </div>
    </div>
}

@code {
    private RegisterDTO registerModel = new();
    private string nombreCompleto = string.Empty;
    private string mensajeError = string.Empty;
    private bool cargando = false;
    private bool mostrarPassword = false;
    private bool terminosAceptados = false;
    private bool mostrarModalExito = false;

    private string googleClientId = string.Empty;
    private DotNetObjectReference<Register>? googleDotNetRef;

    private string tipoPassword =>
        mostrarPassword ? "text" : "password";

    private bool TieneMinimo8 =>
        registerModel.Password?.Length >= 8;

    private bool TieneMayuscula =>
        !string.IsNullOrEmpty(registerModel.Password) &&
        registerModel.Password.Any(char.IsUpper);

    private bool TieneNumero =>
        !string.IsNullOrEmpty(registerModel.Password) &&
        registerModel.Password.Any(char.IsDigit);

    private bool TieneSimbolo =>
        !string.IsNullOrEmpty(registerModel.Password) &&
        registerModel.Password.Any(c => !char.IsLetterOrDigit(c));

    private bool PasswordSegura =>
        TieneMinimo8 &&
        TieneMayuscula &&
        TieneNumero &&
        TieneSimbolo;

    private string ColorRegla(bool cumple) =>
        cumple ? "#22c55e" : "#94a3b8";

    private void TogglePassword() =>
        mostrarPassword = !mostrarPassword;


    // ==========================================
    // GOOGLE - ABRIR POPUP DESDE NUESTRO BOTÓN
    // ==========================================

    private async Task IniciarGoogle()
    {
        mensajeError =
            string.Empty;

        try
        {
            await JS.InvokeVoidAsync(
                "nexoGoogleAuth.requestCode",
                "register");
        }
        catch (Exception ex)
        {
            mensajeError =
                "No se pudo abrir Google.";

            Console.WriteLine(
                $"Error abriendo Google Register: {ex.Message}");
        }
    }


    // ==========================================
    // GOOGLE - INICIALIZAR CLIENTE
    // ==========================================

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
            return;

        googleClientId =
            Configuration["GoogleAuth:ClientId"]
            ?? string.Empty;

        if (string.IsNullOrWhiteSpace(
                googleClientId))
        {
            mensajeError =
                "Google Login todavía no está configurado en el Web.";

            await InvokeAsync(
                StateHasChanged);

            return;
        }

        googleDotNetRef =
            DotNetObjectReference.Create(this);

        await JS.InvokeVoidAsync(
            "nexoGoogleAuth.initializeCodeClient",
            googleClientId,
            googleDotNetRef,
            "register");
    }


    private async Task ProcesarRegistro()
    {
        mensajeError = string.Empty;

        if (!terminosAceptados)
        {
            mensajeError =
                "Debes aceptar los términos y la política de privacidad.";
            return;
        }

        if (string.IsNullOrWhiteSpace(nombreCompleto))
        {
            mensajeError = "Ingresa tu nombre completo.";
            return;
        }

        if (!PasswordSegura)
        {
            mensajeError =
                "La contraseña debe tener mínimo 8 caracteres, una mayúscula, un número y un símbolo.";
            return;
        }

        cargando = true;

        var partes =
            nombreCompleto.Trim().Split(
                ' ',
                2,
                StringSplitOptions.RemoveEmptyEntries);

        registerModel.Nombres =
            partes.Length > 0 ? partes[0] : string.Empty;

        registerModel.Apellidos =
            partes.Length > 1 ? partes[1] : "-";

        try
        {
            var response =
                await Http.PostAsJsonAsync(
                    "api/Auth/register",
                    registerModel);

            if (response.IsSuccessStatusCode)
            {
                cargando = false;
                mostrarModalExito = true;

                await InvokeAsync(
                    StateHasChanged);

                await Task.Delay(1800);

                Navigation.NavigateTo(
                    "/login",
                    forceLoad: true);

                return;
            }

            var error =
                await response.Content
                    .ReadFromJsonAsync<AuthResponseDTO>();

            mensajeError =
                error?.Mensaje
                ?? "No se pudo registrar el usuario.";
        }
        catch (Exception ex)
        {
            mensajeError =
                "No se pudo conectar con el servidor.";

            Console.WriteLine(
                $"Error Registro: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }

    [JSInvokable]
    public async Task ProcesarGoogleCode(
        string code)
    {
        mensajeError =
            string.Empty;

        if (string.IsNullOrWhiteSpace(
                code))
        {
            mensajeError =
                "Google no devolvió un código válido.";

            return;
        }

        cargando =
            true;

        try
        {
            var response =
                await Http.PostAsJsonAsync(
                    "api/Auth/google",
                    new GoogleCodeDTO
                    {
                        Code = code
                    });

            if (response.IsSuccessStatusCode)
            {
                var resultado =
                    await response.Content
                        .ReadFromJsonAsync<GoogleLoginResultDTO>();

                if (resultado == null ||
                    string.IsNullOrWhiteSpace(
                        resultado.Token))
                {
                    mensajeError =
                        "El servidor no devolvió un token válido.";

                    return;
                }

                await GuardarSesionGoogleAsync(
                    resultado.Token,
                    resultado.Correo,
                    resultado.Nombre);

                return;
            }

            var error =
                await response.Content
                    .ReadFromJsonAsync<AuthResponseDTO>();

            mensajeError =
                error?.Mensaje
                ?? "No se pudo registrar con Google.";
        }
        catch (Exception ex)
        {
            mensajeError =
                "No se pudo completar el registro con Google.";

            Console.WriteLine(
                $"Error Google Register: {ex.Message}");
        }
        finally
        {
            cargando =
                false;

            await InvokeAsync(
                StateHasChanged);
        }
    }


    private async Task GuardarSesionGoogleAsync(
        string token,
        string? correo,
        string? nombre)
    {
        await JS.InvokeVoidAsync(
            "localStorage.setItem",
            "authToken",
            token);

        var correoFinal =
            correo ?? string.Empty;

        await JS.InvokeVoidAsync(
            "localStorage.setItem",
            "userEmail",
            correoFinal);

        var nombreFinal =
            !string.IsNullOrWhiteSpace(nombre)
                ? nombre
                : correoFinal.Contains("@")
                    ? correoFinal.Split('@')[0]
                    : correoFinal;

        await JS.InvokeVoidAsync(
            "localStorage.setItem",
            "userName",
            nombreFinal);

        await JS.InvokeVoidAsync(
            "localStorage.removeItem",
            "userRol");

        await AuthState.InicializarAsync();

        Navigation.NavigateTo(
            "/",
            forceLoad: true);
    }

    public ValueTask DisposeAsync()
    {
        googleDotNetRef?.Dispose();
        return ValueTask.CompletedTask;
    }
}
