@page "/Marcas"
@using SysNova.DTO
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http

<div class="main-container py-4">
    <div class="container">
        <!-- Encabezado y Acción de Administrador -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="text-gold fw-bold m-0">Nuestras Marcas</h2>
                <p class="text-muted mb-0">Marcas destacadas disponibles en el catálogo</p>
            </div>
            <AuthorizeView Roles="Administrador">
                <Authorized>
                    <button class="btn btn-warning text-dark fw-bold shadow-sm" @onclick="AbrirModalCrear">
                        <i class="bi bi-plus-lg me-1"></i> Agregar Marca
                    </button>
                </Authorized>
            </AuthorizeView>
        </div>

        <!-- Carga de datos -->
        @if (cargando)
        {
            <div class="d-flex justify-content-center align-items-center py-5">
                <div class="spinner-border text-gold" role="status">
                    <span class="visually-hidden">Cargando marcas...</span>
                </div>
            </div>
        }
        else if (marcasVisibles == null || !marcasVisibles.Any())
        {
            <div class="text-center py-5 text-muted">
                <p class="fs-5">No hay marcas activas registradas.</p>
            </div>
        }
        else
        {
            <!-- Grid de Tarjetas de Marca -->
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
                @foreach (var marca in marcasVisibles)
                {
                    <div class="col">
                        <div class="card card-categoria h-100 bg-slate-800 border border-secondary shadow-custom transition-all text-light rounded-3 overflow-hidden">
                            <div class="p-3 bg-slate-900 d-flex justify-content-center align-items-center" style="height: 140px;">
                                @if (!string.IsNullOrEmpty(marca.Logo))
                                {
                                    <img src="@marca.Logo" alt="@marca.Nombre" class="img-fluid object-fit-contain style-logo" style="max-height: 100px;" />
                                }
                                else
                                {
                                    <span class="fs-3 fw-bold text-gold">@marca.Nombre</span>
                                }
                            </div>
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title text-gold fw-bold">@marca.Nombre</h5>

                                @if (!string.IsNullOrEmpty(marca.Pais))
                                {
                                    <span class="badge bg-secondary mb-2 align-self-start">@marca.Pais</span>
                                }

                                @if (!string.IsNullOrEmpty(marca.Descripcion))
                                {
                                    <p class="card-text text-slate-300 small line-clamp-2 mb-3">@marca.Descripcion</p>
                                }

                                <AuthorizeView Roles="Administrador">
                                    <Authorized>
                                        <div class="mt-auto pt-2 border-top border-secondary d-flex justify-content-end gap-2">
                                            <button class="btn btn-sm btn-outline-warning" @onclick="() => AbrirModalEditar(marca)">Editar</button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarMarca(marca.MarcaId)">Eliminar</button>
                                        </div>
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Modal CRUD (Administrador) -->
    @if (mostrarModal)
    {
        <div class="custom-modal-backdrop">
            <div class="custom-modal-dialog">
                <div class="modal-dark-content p-4 rounded-3 border border-secondary shadow-custom">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="modal-title text-gold fw-bold">
                            @(marcaForm.MarcaId == 0 ? "Nueva Marca" : "Editar Marca")
                        </h4>
                        <button type="button" class="btn-close btn-close-custom" @onclick="CerrarModal"></button>
                    </div>

                    <EditForm Model="marcaForm" OnValidSubmit="GuardarMarca">
                        <DataAnnotationsValidator />

                        <div class="custom-modal-body pe-2">
                            <div class="mb-3">
                                <label class="form-label text-light">Nombre</label>
                                <InputText @bind-Value="marcaForm.Nombre" class="form-control input-dark" placeholder="Ej: Sony" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-light">Descripción</label>
                                <InputTextArea @bind-Value="marcaForm.Descripcion" class="form-control input-dark" rows="3" placeholder="Breve descripción..." />
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-light">URL del Logo</label>
                                <InputText @bind-Value="marcaForm.Logo" class="form-control input-dark" placeholder="https://..." />
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label text-light">País de Origen</label>
                                    <InputText @bind-Value="marcaForm.Pais" class="form-control input-dark" placeholder="Ej: Japón" />
                                </div>
                                <div class="col-md-6 mb-3 d-flex align-items-end">
                                    <div class="form-check form-switch mb-2">
                                        <InputCheckbox @bind-Value="marcaForm.Activo" class="form-check-input" id="checkMarcaActivo" />
                                        <label class="form-check-label text-light" for="checkMarcaActivo">Activo</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top border-secondary">
                            <button type="button" class="btn btn-outline-light" @onclick="CerrarModal">Cancelar</button>
                            <button type="submit" class="btn btn-warning text-dark fw-bold">Guardar</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<MarcaDTO> listaMarcas = new();
    private List<MarcaDTO> marcasVisibles = new();
    private MarcaDTO marcaForm = new();
    private bool cargando = true;
    private bool mostrarModal = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarMarcas();
    }

    private async Task CargarMarcas()
    {
        cargando = true;
        try
        {
            var resultado = await Http.GetFromJsonAsync<List<MarcaDTO>>("api/Marca");
            if (resultado != null)
            {
                listaMarcas = resultado;
                marcasVisibles = listaMarcas.Where(m => m.Activo).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar marcas: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirModalCrear()
    {
        marcaForm = new MarcaDTO
        {
            Activo = true,
            FechaCreacion = DateTime.Now
        };
        mostrarModal = true;
    }

    private void AbrirModalEditar(MarcaDTO marca)
    {
        marcaForm = new MarcaDTO
        {
            MarcaId = marca.MarcaId,
            Nombre = marca.Nombre,
            Descripcion = marca.Descripcion,
            Logo = marca.Logo,
            Pais = marca.Pais,
            Activo = marca.Activo,
            FechaCreacion = marca.FechaCreacion
        };
        mostrarModal = true;
    }

    private void CerrarModal() => mostrarModal = false;

    private async Task GuardarMarca()
    {
        try
        {
            if (marcaForm.MarcaId == 0)
            {
                var response = await Http.PostAsJsonAsync("api/Marca", marcaForm);
                if (response.IsSuccessStatusCode)
                {
                    await CargarMarcas();
                    CerrarModal();
                }
            }
            else
            {
                marcaForm.FechaModificacion = DateTime.Now;
                var response = await Http.PutAsJsonAsync("api/Marca", marcaForm);
                if (response.IsSuccessStatusCode)
                {
                    await CargarMarcas();
                    CerrarModal();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al guardar marca: {ex.Message}");
        }
    }

    private async Task EliminarMarca(int id)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/Marca/{id}");
            if (response.IsSuccessStatusCode)
            {
                await CargarMarcas();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al eliminar marca: {ex.Message}");
        }
    }
}