@using SysNova.DTO

@if (mostrarModal && producto != null)
{
    <div class="producto-detalle-backdrop"
         @onclick="CerrarModal">

        <div class="producto-detalle-modal"
             @onclick:stopPropagation="true">

            <!-- BOTÓN CERRAR -->
            <button type="button"
                    class="producto-detalle-close"
                    @onclick="CerrarModal"
                    aria-label="Cerrar">
                <i class="bi bi-x-lg"></i>
            </button>

            <div class="producto-detalle-grid">

                <!-- ================================================= -->
                <!-- IZQUIERDA -->
                <!-- ================================================= -->
                <div class="producto-detalle-imagen-panel">

                    @if (producto.Destacado)
                    {
                        <span class="producto-detalle-top">
                            Top ventas
                        </span>
                    }

                    <div class="producto-detalle-image-box">
                        <img src="@(string.IsNullOrWhiteSpace(producto.ImagenPrincipal)
                                                         ? "images/laptop-hero.png"
                                                         : producto.ImagenPrincipal)"
                         alt="@producto.Nombre" />
                </div>

                </div>


                <!-- ================================================= -->
                <!-- DERECHA -->
                <!-- ================================================= -->
                <div class="producto-detalle-info">

                    <!-- CATEGORÍA -->
                    <div class="producto-detalle-categoria">
                        LAPTOPS
                    </div>

                    <!-- NOMBRE -->
                    <h2 class="producto-detalle-titulo">
                        @producto.Nombre
                    </h2>

                    <!-- ESTRELLAS -->
                    <div class="producto-detalle-rating">

                        <div class="producto-detalle-stars">
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                        </div>

                        <strong>4.9</strong>

                        <span>
                            (312 reseñas)
                        </span>

                    </div>


                    <!-- PRECIO -->
                    <div class="producto-detalle-precio">

                        <span class="producto-detalle-precio-actual">
                            US$ @producto.Precio.ToString("N0")
                        </span>

                    @if (producto.PrecioAnterior.HasValue &&
                                        producto.PrecioAnterior.Value > 0)
                        {
                            <span class="producto-detalle-precio-anterior">
                                US$ @producto.PrecioAnterior.Value.ToString("N0")
                            </span>
                        }

                        @if (producto.PorcentajeDescuento.HasValue &&
                                            producto.PorcentajeDescuento.Value > 0)
                        {
                            <span class="producto-detalle-descuento">
                                -@producto.PorcentajeDescuento%
                            </span>
                        }

                </div>


                <!-- DESCRIPCIÓN -->
                <p class="producto-detalle-descripcion">
                    @producto.Descripcion
                </p>


                <!-- SEPARADOR -->
                <div class="producto-detalle-separador"></div>


                <!-- INFORMACIÓN -->
                <div class="producto-detalle-beneficios">

                    <div>
                        <i class="bi bi-shield-check"></i>
                        <span>Garantía oficial</span>
                    </div>

                    <div>
                        <i class="bi bi-truck"></i>
                        <span>Envío gratis +$99</span>
                    </div>

                </div>


                <!-- PARTE INFERIOR -->
                <div class="producto-detalle-compra">

                    <!-- CANTIDAD -->
                    <div class="producto-detalle-cantidad">

                        <span>
                            Cantidad
                        </span>

                        <div class="producto-detalle-selector">

                            <button type="button"
                                    @onclick="DecrementarCantidad"
                                    disabled="@(cantidad <= 1)">
                                −
                            </button>

                            <span>
                                @cantidad
                            </span>

                            <button type="button"
                                    @onclick="IncrementarCantidad"
                                    disabled="@(cantidad >= producto.Stock)">
                                +
                            </button>

                        </div>

                    </div>


                    <!-- BOTÓN CARRITO -->
                    <button type="button"
                            class="producto-detalle-carrito"
                            disabled="@(producto.Stock <= 0)"
                            @onclick="AgregarAlCarrito">

                        <i class="bi bi-cart3"></i>

                        <span>
                            @(producto.Stock <= 0
                                                        ? "Agotado"
                                                        : $"Añadir al carrito · US$ {(producto.Precio * cantidad).ToString("N0")}")
                        </span>

                        </button>


                        <!-- TEXTO FINAL -->
                        <div class="producto-detalle-seguridad">

                            <i class="bi bi-check-lg"></i>

                            <span>
                                Compra segura y soporte NEXO incluido
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>
    </div>
}

@code {

    [Parameter]
    public bool mostrarModal { get; set; }

    [Parameter]
    public EventCallback<bool> mostrarModalChanged { get; set; }

    [Parameter]
    public ProductoDTO producto { get; set; } = new();

    private int cantidad = 1;

    protected override void OnParametersSet()
    {
        if (mostrarModal)
        {
            cantidad = 1;
        }
    }

    private void IncrementarCantidad()
    {
        if (producto.Stock > 0 && cantidad < producto.Stock)
        {
            cantidad++;
        }
    }

    private void DecrementarCantidad()
    {
        if (cantidad > 1)
        {
            cantidad--;
        }
    }

    private async Task CerrarModal()
    {
        mostrarModal = false;

        await mostrarModalChanged.InvokeAsync(false);
    }

    private async Task AgregarAlCarrito()
    {
        if (producto.Stock <= 0)
            return;

        Console.WriteLine(
            $"Agregado: {producto.Nombre} | Cantidad: {cantidad}"
        );

        await CerrarModal();
    }
}