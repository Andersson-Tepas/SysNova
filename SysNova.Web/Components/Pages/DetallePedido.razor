            ? "/placeholder.png"

            : imagen;
    }



    // ==========================================
    // TEXTO ESTADO
    // ==========================================

    private static string ObtenerTextoEstado(
        EstadoPedido estado)
    {
        return estado switch
        {
            EstadoPedido.Pendiente =>
                "Pendiente",

            EstadoPedido.Confirmado =>
                "Confirmado",

            EstadoPedido.Preparando =>
                "Preparando",

            EstadoPedido.Enviado =>
                "Enviado",

            EstadoPedido.Entregado =>
                "Entregado",

            EstadoPedido.Cancelado =>
                "Cancelado",

            _ =>
                estado.ToString()
        };
    }



    // ==========================================
    // BADGE
    // ==========================================

    private static string ObtenerClaseBadge(
        EstadoPedido estado)
    {
        return estado switch
        {
            EstadoPedido.Pendiente =>
                "bg-warning text-dark",

            EstadoPedido.Confirmado =>
                "bg-primary text-white",

            EstadoPedido.Preparando =>
                "bg-info text-dark",

            EstadoPedido.Enviado =>
                "bg-primary text-white",

            EstadoPedido.Entregado =>
                "bg-success text-white",

            EstadoPedido.Cancelado =>
                "bg-danger text-white",

            _ =>
                "bg-secondary text-white"
        };
    }



    // ==========================================
    // TIMELINE
    // ==========================================

    private static string ObtenerClasePaso(
        EstadoPedido estadoActual,
        EstadoPedido estadoPaso)
    {
        if (estadoActual ==
            EstadoPedido.Cancelado)
        {
            return
                "border-secondary text-secondary";
        }


        if ((int)estadoActual >=
            (int)estadoPaso)
        {
            return
                "border-warning bg-warning text-dark";
        }


        return
            "border-secondary text-secondary";
    }



    private static string ObtenerClaseTextoPaso(
        EstadoPedido estadoActual,
        EstadoPedido estadoPaso)
    {
        if (estadoActual ==
            EstadoPedido.Cancelado)
        {
            return
                "text-secondary";
        }


        if ((int)estadoActual >=
            (int)estadoPaso)
        {
            return
                "text-white";
        }


        return
            "text-secondary";
    }



