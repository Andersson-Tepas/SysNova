    // =========================================================
    // FAVORITOS
    // =========================================================

    private async Task CargarFavoritos()
    {
        try
        {
            var favsJson =
                await JS.InvokeAsync<string?>(
                    "localStorage.getItem",
                    "sysnova_favoritos");

            if (string.IsNullOrWhiteSpace(favsJson))
            {
                idsFavoritos = new HashSet<int>();
                return;
            }

            var lista =
                System.Text.Json.JsonSerializer
                    .Deserialize<List<int>>(favsJson);

            idsFavoritos =
                lista != null
                    ? new HashSet<int>(lista)
                    : new HashSet<int>();
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Error al cargar favoritos: {ex.Message}");

            idsFavoritos = new HashSet<int>();
        }
    }


    private async Task ToggleFavorito(int id)
    {
        try
        {
            if (idsFavoritos.Contains(id))
            {
                idsFavoritos.Remove(id);
            }
            else
            {
                idsFavoritos.Add(id);
            }

            var json =
                System.Text.Json.JsonSerializer
                    .Serialize(idsFavoritos.ToList());

            await JS.InvokeVoidAsync(
                "localStorage.setItem",
                "sysnova_favoritos",
                json);

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Error al guardar favorito: {ex.Message}");

            await JS.InvokeVoidAsync(
                "alert",
                $"No se pudo actualizar favoritos: {ex.Message}");
        }
    }


