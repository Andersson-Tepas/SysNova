    // =========================================================
    // SUBIR IMAGEN
    // =========================================================

    private async Task SubirImagenProducto(
        InputFileChangeEventArgs e)
    {
        if (!esAdmin)
            return;

        var archivo = e.File;

        if (archivo == null)
            return;

        const long maxFileSize =
            10 * 1024 * 1024;

        var extensionesPermitidas =
            new[]
            {
                ".png",
                ".jpg",
                ".jpeg",
                ".webp"
            };

        var extension =
            Path.GetExtension(archivo.Name)
                .ToLowerInvariant();

        if (!extensionesPermitidas.Contains(extension))
        {
            await JS.InvokeVoidAsync(
                "alert",
                "Formato no permitido. Usa PNG, JPG, JPEG o WEBP.");

            return;
        }

        if (archivo.Size > maxFileSize)
        {
            await JS.InvokeVoidAsync(
                "alert",
                "La imagen no puede superar los 10 MB.");

            return;
        }

        subiendoImagen = true;

        try
        {
            await AplicarTokenAutorizacion();

            using var contenido =
                new MultipartFormDataContent();

            await using var stream =
                archivo.OpenReadStream(maxFileSize);

            using var archivoContent =
                new StreamContent(stream);

            archivoContent.Headers.ContentType =
                new System.Net.Http.Headers.MediaTypeHeaderValue(
                    string.IsNullOrWhiteSpace(archivo.ContentType)
                        ? "application/octet-stream"
                        : archivo.ContentType);

            contenido.Add(
                archivoContent,
                "archivo",
                archivo.Name);

            var response =
                await Http.PostAsync(
                    "api/producto/upload-imagen",
                    contenido);

            if (!response.IsSuccessStatusCode)
            {
                var detalle =
                    await response.Content.ReadAsStringAsync();

                await JS.InvokeVoidAsync(
                    "alert",
                    $"No se pudo subir la imagen. {detalle}");

                return;
            }

            var resultado =
                await response.Content
                    .ReadFromJsonAsync<ImagenUploadResponse>();

            if (resultado == null ||
                string.IsNullOrWhiteSpace(resultado.Url))
            {
                await JS.InvokeVoidAsync(
                    "alert",
                    "La API no devolvió la URL de la imagen.");

                return;
            }

            formModel.ImagenPrincipal =
                resultado.Url;
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync(
                "alert",
                $"Error al subir la imagen: {ex.Message}");
        }
        finally
        {
            subiendoImagen = false;

            await InvokeAsync(
                StateHasChanged);
        }
    }


    private sealed class ImagenUploadResponse
    {
        public string Url { get; set; } =
            string.Empty;

        public string NombreArchivo { get; set; } =
            string.Empty;
    }


    // =========================================================
    // GUARDAR
    // =========================================================

    private async Task GuardarProducto()
    {
        if (!esAdmin)
        {
            return;
        }

        if (formModel.CategoriaId <= 0)
        {
            await JS.InvokeVoidAsync(
                "alert",
                "Selecciona una categoría.");

            return;
        }

        if (formModel.MarcaId <= 0)
        {
            await JS.InvokeVoidAsync(
                "alert",
                "Selecciona una marca.");

            return;
        }


        guardando = true;


        try
        {
            await AplicarTokenAutorizacion();


            HttpResponseMessage response;


            if (esEdicion)
            {
                formModel.FechaModificacion =
                    DateTime.Now;


                response =
                    await Http.PutAsJsonAsync(
                        "api/producto",
                        formModel);
            }
            else
            {
                response =
                    await Http.PostAsJsonAsync(
                        "api/producto",
                        formModel);
            }


            if (response.IsSuccessStatusCode)
            {
                await CerrarModal();

                await CargarProductos();
            }
            else
            {
                var errorMsg =
                    await response.Content
                        .ReadAsStringAsync();


                Console.WriteLine(
                    $"Error HTTP {(int)response.StatusCode}: {errorMsg}");


                await JS.InvokeVoidAsync(
                    "alert",
                    $"Error al guardar producto ({response.StatusCode}). Revisa la consola o los datos ingresados.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Error de excepción al guardar: {ex.Message}");


            await JS.InvokeVoidAsync(
                "alert",
                $"Error de conexión: {ex.Message}");
        }
        finally
        {
            guardando = false;
        }
    }


    // =========================================================
    // ELIMINAR
    // =========================================================

    private async Task EliminarProducto(int id)
    {
        if (!esAdmin)
        {
            return;
        }


        bool confirmado =
            await JS.InvokeAsync<bool>(
                "confirm",
                "¿Estás seguro de eliminar este producto?");


        if (!confirmado)
        {
            return;
        }


        try
        {
            await AplicarTokenAutorizacion();


            var response =
                await Http.DeleteAsync(
                    $"api/producto/{id}");


            if (response.IsSuccessStatusCode)
            {
                await CargarProductos();
            }
            else
            {
                await JS.InvokeVoidAsync(
                    "alert",
                    $"No se pudo eliminar el producto. Código: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Error al eliminar: {ex.Message}");
        }
    }


