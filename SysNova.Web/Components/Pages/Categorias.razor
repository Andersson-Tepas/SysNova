@page "/categorias"
@using SysNova.DTO
@using System.Net.Http.Json
@using System.Text.Json
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Categorías - NEXO Tech</PageTitle>

<div class="container-fluid py-4 px-md-5" style="background-color: #0f172a; min-height: 90vh; color: #f8fafc;">

    <!-- ENCABEZADO DE PÁGINA -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom border-secondary border-opacity-25">
        <div>
            <h2 class="fw-bold text-white mb-1">
                <i class="bi bi-grid-fill text-warning me-2"></i>Categorías
            </h2>
            <p class="text-secondary small mb-0">
                @(esAdmin ? "Panel de administración y control de categorías" : "Explora los componentes y tecnología por categoría")
            </p>
        </div>

        @if (esAdmin)
        {
            <div class="mt-3 mt-md-0">
                <button class="btn btn-warning fw-bold px-4 rounded-3 shadow-sm" @onclick="AbrirModalCrear">
                    <i class="bi bi-plus-lg me-1"></i> Nueva Categoría
                </button>
            </div>
        }
    </div>

    <!-- MODO CARGANDO -->
    @if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-warning" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="text-secondary mt-2">Cargando categorías...</p>
        </div>
    }
    else
    {
        <!-- VISTA ADMINISTRADOR (TABLA DE CONTROL) -->
        @if (esAdmin)
        {
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-4" style="background-color: #1e293b;">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-dark table-hover align-middle mb-0" style="background-color: #1e293b;">
                            <thead class="bg-black bg-opacity-25 text-warning border-bottom border-secondary border-opacity-25">
                                <tr>
                                    <th class="ps-4">ID</th>
                                    <th>Categoría</th>
                                    <th>Descripción</th>
                                    <th class="text-center">Estado</th>
                                    <th class="text-end pe-4">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (listaCategorias == null || !listaCategorias.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-secondary">No hay categorías registradas.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var cat in listaCategorias)
                                    {
                                        <tr>
                                            <td class="ps-4 text-secondary">#@cat.CategoriaId</td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="rounded-3 p-2 me-3 d-flex align-items-center justify-content-center"
                                                         style="background-color: #0f172a; width: 42px; height: 42px;">
                                                        <i class="@(string.IsNullOrEmpty(cat.Icono) ? "bi bi-tag-fill" : cat.Icono) text-warning fs-5"></i>
                                                    </div>
                                                    <span class="fw-bold text-white">@cat.Nombre</span>
                                                </div>
                                            </td>
                                            <td class="text-secondary small">
                                                @(string.IsNullOrEmpty(cat.Descripcion) ? "Sin descripción" : cat.Descripcion)
                                            </td>
                                            <td class="text-center">
                                                @if (cat.Activo)
                                                {
                                                    <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 rounded-pill px-3 py-2">
                                                        Activo
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-25 rounded-pill px-3 py-2">
                                                        Inactivo
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-end pe-4">
                                                <button class="btn btn-outline-warning btn-sm me-2 rounded-2" @onclick="() => AbrirModalEditar(cat)">
                                                    <i class="bi bi-pencil-square"></i>
                                                </button>
                                                <button class="btn btn-outline-danger btn-sm rounded-2" @onclick="() => EliminarCategoria(cat.CategoriaId)">
                                                    <i class="bi bi-trash-fill"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- VISTA PÚBLICO / CLIENTE (TARJETAS DE CATÁLOGO) -->
            <div class="row g-4">
                @if (listaCategorias == null || !listaCategorias.Where(c => c.Activo).Any())
                {
                    <div class="col-12 text-center py-5">
                        <p class="text-secondary">No hay categorías disponibles por el momento.</p>
                    </div>
                }
                else
                {
                    @foreach (var cat in listaCategorias.Where(c => c.Activo))
                    {
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                            <div class="card h-100 border-0 rounded-4 shadow-sm text-center p-4 card-categoria"
                                 style="background-color: #1e293b; transition: transform 0.2s ease, border-color 0.2s ease; cursor: pointer;">
                                <div class="rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center"
                                     style="background-color: #0f172a; width: 70px; height: 70px;">
                                    <i class="@(string.IsNullOrEmpty(cat.Icono) ? "bi bi-laptop" : cat.Icono) text-warning fs-2"></i>
                                </div>
                                <h5 class="fw-bold text-white mb-2">@cat.Nombre</h5>
                                <p class="text-secondary small mb-3">@cat.Descripcion</p>
                                <a href="/productos?categoriaId=@cat.CategoriaId" class="btn btn-outline-light btn-sm rounded-3 w-100 mt-auto">
                                    Ver Productos <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    }
                }
            </div>
        }
    }
</div>

<!-- MODAL FORMULARIO (ADMIN) -->
@if (mostrarModal)
{
    <div class="modal fade show d-block custom-modal-backdrop" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered custom-modal-dialog" role="document">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden" style="background-color: #1e293b; color: #f8fafc;">

                <div class="modal-header border-bottom border-secondary border-opacity-25">
                    <h5 class="modal-title fw-bold text-white">
                        <i class="bi bi-tag-fill text-warning me-2"></i>
                        @(categoriaActual.CategoriaId == 0 ? "Nueva Categoría" : "Editar Categoría")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal" aria-label="Close"></button>
                </div>

                <EditForm Model="categoriaActual" OnValidSubmit="GuardarCategoria">
                    <DataAnnotationsValidator />

                    <div class="modal-body custom-modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label text-secondary small fw-bold">Nombre</label>
                            <InputText @bind-Value="categoriaActual.Nombre" class="form-control input-dark w-100" placeholder="Ej: Procesadores" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-secondary small fw-bold">Descripción</label>
                            <InputTextArea @bind-Value="categoriaActual.Descripcion" class="form-control input-dark w-100" rows="3" placeholder="Descripción breve..." />
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-secondary small fw-bold">Icono (Bootstrap Icons)</label>
                            <InputText @bind-Value="categoriaActual.Icono" class="form-control input-dark w-100" placeholder="Ej: bi bi-cpu" />
                        </div>
                        <div class="form-check form-switch mb-2">
                            <InputCheckbox @bind-Value="categoriaActual.Activo" class="form-check-input" id="estadoCheck" />
                            <label class="form-check-label text-white" for="estadoCheck">Categoría Activa</label>
                        </div>
                    </div>

                    <div class="modal-footer border-top border-secondary border-opacity-25">
                        <button type="button" class="btn btn-outline-secondary rounded-3" @onclick="CerrarModal">Cancelar</button>
                        <button type="submit" class="btn btn-warning fw-bold rounded-3 px-4" disabled="@guardando">
                            @if (guardando)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            }
                            Guardar
                        </button>
                    </div>
                </EditForm>

            </div>
        </div>
    </div>
}

@code {
    private List<CategoriaDTO> listaCategorias = new();
    private CategoriaDTO categoriaActual = new();
    private bool cargando = true;
    private bool guardando = false;
    private bool mostrarModal = false;
    private bool esAdmin = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await VerificarRol();
            await CargarCategorias();
            StateHasChanged();
        }
    }

    private async Task BloquearScrollFondo(bool bloquear)
    {
        try
        {
            var overflowValue = bloquear ? "hidden" : "";
            await JS.InvokeVoidAsync("eval", $"document.body.style.overflow = '{overflowValue}'");
        }
        catch
        {
            // Ignorar errores de JS durante prerendering
        }
    }

    private async Task VerificarRol()
    {
        try
        {
            var rol = await JS.InvokeAsync<string>("localStorage.getItem", "userRol");
            var correo = await JS.InvokeAsync<string>("localStorage.getItem", "userEmail");

            esAdmin = (!string.IsNullOrEmpty(rol) && rol.Equals("Administrador", StringComparison.OrdinalIgnoreCase))
                   || (!string.IsNullOrEmpty(correo) && correo.Equals("admin@sysnova.com", StringComparison.OrdinalIgnoreCase));
        }
        catch
        {
            esAdmin = false;
        }
    }

    private async Task AplicarTokenAutorizacion()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        if (!string.IsNullOrEmpty(token))
        {
            Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        }
    }

    private async Task CargarCategorias()
    {
        cargando = true;
        try
        {
            await AplicarTokenAutorizacion();
            var respuesta = await Http.GetFromJsonAsync<List<CategoriaDTO>>("api/Categoria");
            if (respuesta != null)
            {
                listaCategorias = respuesta;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar categorías: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task AbrirModalCrear()
    {
        categoriaActual = new CategoriaDTO { Activo = true, FechaCreacion = DateTime.Now };
        mostrarModal = true;
        await BloquearScrollFondo(true);
    }

    private async Task AbrirModalEditar(CategoriaDTO cat)
    {
        categoriaActual = new CategoriaDTO
        {
            CategoriaId = cat.CategoriaId,
            Nombre = cat.Nombre,
            Descripcion = cat.Descripcion,
            Icono = cat.Icono,
            Imagen = cat.Imagen,
            Activo = cat.Activo,
            FechaCreacion = cat.FechaCreacion
        };
        mostrarModal = true;
        await BloquearScrollFondo(true);
    }

    private async Task CerrarModal()
    {
        mostrarModal = false;
        await BloquearScrollFondo(false);
    }

    private async Task GuardarCategoria()
    {
        guardando = true;
        try
        {
            await AplicarTokenAutorizacion();
            HttpResponseMessage response;

            if (categoriaActual.CategoriaId == 0)
            {
                // CREAR: POST
                response = await Http.PostAsJsonAsync("api/Categoria", categoriaActual);
            }
            else
            {
                // EDITAR: PUT (Revisa si tu API espera el ID en la URL o solo en el body)
                categoriaActual.FechaModificacion = DateTime.Now;
                response = await Http.PutAsJsonAsync($"api/Categoria/{categoriaActual.CategoriaId}", categoriaActual);
            }

            if (response.IsSuccessStatusCode)
            {
                await CerrarModal();
                await CargarCategorias();
            }
            else
            {
                var errorDetalle = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Error HTTP {(int)response.StatusCode}: {errorDetalle}");
                await JS.InvokeVoidAsync("alert", $"No se pudo guardar la categoría. Servidor respondió: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Excepción al guardar categoría: {ex.Message}");
            await JS.InvokeVoidAsync("alert", $"Error de conexión: {ex.Message}");
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task EliminarCategoria(int id)
    {
        bool confirmado = await JS.InvokeAsync<bool>("confirm", "¿Estás seguro de eliminar esta categoría?");
        if (confirmado)
        {
            try
            {
                await AplicarTokenAutorizacion();
                var response = await Http.DeleteAsync($"api/Categoria/{id}");

                if (response.IsSuccessStatusCode)
                {
                    await CargarCategorias();
                }
                else
                {
                    await JS.InvokeVoidAsync("alert", "Error al intentar eliminar la categoría.");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error al eliminar categoría: {ex.Message}");
            }
        }
    }
}