            cargandoPreguntas = true;

            var result =
                await Http.GetFromJsonAsync<List<PreguntaFrecuenteDTO>>(
                    "api/preguntafrecuente");

            if (result != null)
            {
                listaPreguntas = result
                    .Where(x => x.Activo && x.Mostrar)
