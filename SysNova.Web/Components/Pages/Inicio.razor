    // PRODUCTOS
    // =========================================================

    private async Task CargarProductosBD()
    {
        try
        {
            cargandoProductos = true;

            var result =
                await Http.GetFromJsonAsync<List<ProductoDTO>>(
                    "api/producto");

            if (result != null)
            {
                listaProductos = result
                    .Where(x => x.Activo)
                    .ToList();
