@page "/"
@using System.Text
@using System.Text.Json
@using System.Net.Http.Json
@using SysNova.DTO
@using SysNova.Web.Services
@using SysNova.Web.Components.Pages
@inject HttpClient Http
@inject CarritoService CarritoState
@inject AuthStateService AuthState
@inject IJSRuntime JS

<PageTitle>NEXOTech - Inicio</PageTitle>

<!-- HERO SECTION -->
<section class="hero-section">
    <div class="hero-content">
        <div class="hero-badge">
            <span>Nueva temporada tech 2026</span>
        </div>

        <h1 class="hero-title">
            Tecnología que<br />
            inspira tu día a día
        </h1>

        <p class="hero-description">
            Descubre las últimas laptops, smartphones y gadgets de las marcas líderes.
            Precios premium, envío rápido y garantía oficial en cada compra.
        </p>

        <div class="hero-actions">
            <a href="/productos" class="btn-primary">Comprar ahora &rarr;</a>
            <a href="/ofertas" class="btn-link">Ver ofertas</a>
        </div>

        <div class="hero-stats">
            <div class="stat-item">
                <h3>50k+</h3>
                <p>Clientes felices</p>
            </div>

            <div class="stat-item">
                <h3>1.2k+</h3>
                <p>Productos</p>
            </div>

            <div class="stat-item">
                <h3>4.9 ★</h3>
                <p>Valoración</p>
            </div>
        </div>
    </div>

    <div class="hero-media">
        <div class="floating-badge top-left">
            <span class="badge-icon">🚚</span>
            <div>
                <strong>Envío express</strong>
                <br />
                <small>Entrega en 24h</small>
            </div>
        </div>

        <div class="media-card-main">
            <img src="images/laptop-hero.png" alt="Laptop Premium NEXOTech" />
        </div>

        <div class="floating-badge bottom-right">
            <span class="badge-icon">🛡️</span>
            <div>
                <strong>Garantía oficial</strong>
                <br />
                <small>Hasta 24 meses</small>
            </div>
        </div>
    </div>
</section>


<!-- BANNERS PROMOCIONALES - BASE DE DATOS -->
<section class="promo-slider-section">

    @if (cargandoBanners)
    {
        <div class="promo-card">
            <div class="promo-content">
                <p>Cargando banners...</p>
            </div>
        </div>
    }
    else if (listaBanners.Any())
    {
        <div class="promo-card">

            <button type="button"
                    class="slider-arrow left"
                    aria-label="Anterior">
                &lsaquo;
            </button>

            <div class="promo-image-container">
                <img src="@listaBanners[bannerActual].Imagen"
                     alt="@listaBanners[bannerActual].Titulo" />
            </div>

            <div class="promo-content">

                <span>
                    @listaBanners[bannerActual].Titulo
                </span>

                @if (!string.IsNullOrWhiteSpace(listaBanners[bannerActual].SubTitulo))
                {
                    <h2>
                        @listaBanners[bannerActual].SubTitulo
                    </h2>
                }

                @if (!string.IsNullOrWhiteSpace(listaBanners[bannerActual].BotonTexto))
                {
                    <a href="@listaBanners[bannerActual].BotonUrl"
                       class="btn-secondary">
                        @listaBanners[bannerActual].BotonTexto &rarr;
                    </a>
                }

            </div>

            <button type="button"
                    class="slider-arrow right"
                    aria-label="Siguiente">
                &rsaquo;
            </button>

        </div>
    }
    else
    {
        <div class="promo-card">
            <div class="promo-content">
                <p>No hay banners disponibles.</p>
            </div>
        </div>
    }

</section>


<!-- CATEGORÍAS -->
<section class="categories-section">

    <div class="section-header">
        <span class="section-tag">EXPLORA</span>
        <h2 class="section-title">Categorías de productos</h2>
        <p class="section-subtitle">
            Encuentra justo lo que buscas navegando por nuestras categorías.
        </p>
    </div>

    <div class="categories-grid">

        @if (cargandoCategorias)
        {
            <p>Cargando categorías...</p>
        }
        else if (listaCategorias.Any())
        {
            @foreach (var cat in listaCategorias)
            {
                <div class="category-card"
                     @onclick='() => SeleccionarCategoria(cat.CategoriaId)'
                     style="cursor: pointer;">

                    <div class="category-icon">
                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.5">
                            <path d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                    </div>

                    <h3>@cat.Nombre</h3>

                    <p>
                        @ObtenerCantidadProductosPorCategoria(cat.CategoriaId)
                        productos
                    </p>

                </div>
            }
        }
        else
        {
            <p>No se encontraron categorías disponibles.</p>
        }

    </div>

</section>


<!-- PRODUCTOS DESTACADOS -->
<section class="featured-section">

    <div class="section-header">

        <span class="section-tag">LO MÁS DESEADO</span>

        <h2 class="section-title">
            Productos destacados
        </h2>

        <p class="section-subtitle">
            Selección curada de los equipos favoritos de nuestros clientes.
        </p>

    </div>


    <!-- FILTROS -->
    <div class="filter-pills">

        <button type="button"
                class="pill-btn @(categoriaIdSeleccionada == 0 ? "active" : "")"
                @onclick='() => SeleccionarCategoria(0)'>
            Todos
        </button>

        @if (listaCategorias != null)
        {
            @foreach (var cat in listaCategorias)
            {
                <button type="button"
                        class="pill-btn @(categoriaIdSeleccionada == cat.CategoriaId ? "active" : "")"
                        @onclick='() => SeleccionarCategoria(cat.CategoriaId)'>

                    @cat.Nombre

                </button>
            }
        }

    </div>


    <!-- PRODUCTOS -->
    <div class="products-grid">

        @if (cargandoProductos)
        {
            <p>Cargando productos...</p>
        }
        else if (ProductosFiltrados.Any())
        {
            @foreach (var prod in ProductosFiltrados)
            {
                <div class="product-card"
                     @onclick="() => AbrirDetalleProducto(prod)"
                     style="cursor: pointer;">

                    @if (prod.Nuevo)
                    {
                        <span class="product-badge">
                            Nuevo
                        </span>
                    }
                    else if (prod.Destacado)
                    {
                        <span class="product-badge">
                            Top ventas
                        </span>
                    }

                    <div class="product-img-wrapper">

                        <img src="@(string.IsNullOrEmpty(prod.ImagenPrincipal)
                                                                                                                                                                                                                                                                              ? "images/laptop-hero.png"
                                                                                                                                                                                                                                                                              : prod.ImagenPrincipal)"
                     alt="@prod.Nombre" />

                    </div>

                    <div class="product-info">

                        <span class="product-cat">
                            SKU: @prod.CodigoSKU
                        </span>

                        <h3 class="product-name">
                            @prod.Nombre
                        </h3>

                        <div class="product-rating">

                            <span class="star">★</span>

                            <span class="score">
                                4.8
                            </span>

                            <span class="reviews">
                                (Stock: @prod.Stock)
                            </span>

                        </div>

                        <div class="product-price-box">

                            <div class="prices">

                                <span class="current-price">
                                    US$ @prod.Precio
                                </span>

                        @if (prod.PrecioAnterior.HasValue)
                                {
                                    <span class="old-price">
                                        US$ @prod.PrecioAnterior
                                    </span>
                                }

                            </div>

                            @if (prod.PorcentajeDescuento.HasValue &&
                                                prod.PorcentajeDescuento > 0)
                            {
                                <span class="savings">
                                    Ahorras @prod.PorcentajeDescuento%
                                </span>
                            }
                            else
                            {
                                <span class="savings placeholder-space">
                                    .
                                </span>
                            }

                    </div>

                </div>

                <button type="button"
                        class="btn-add-cart"
                        disabled="@(prod.Stock <= 0)"
                        @onclick="() => AgregarAlCarrito(prod)"
                        @onclick:stopPropagation="true">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2">

                        <path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z" />

                    </svg>

                    @(prod.Stock <= 0
                                    ? "Agotado"
                                    : "Añadir al carrito")

            </button>

                </div>
                }
        }
        else
        {
            <p>
                No se encontraron productos en esta categoría.
            </p>
        }

    </div>


    <div class="catalog-action">
        <a href="/productos"
           class="btn-outline-catalog">
            Ver todo el catálogo
        </a>
    </div>

</section>


<!-- MARCAS - CARRUSEL INFINITO -->
<section class="brands-section">

    <span class="brands-tag">
        MARCAS RECONOCIDAS QUE CONFÍAN EN NOSOTROS
    </span>

    @if (cargandoMarcas)
    {
        <p class="brands-status">Cargando marcas...</p>
    }

    @if (!cargandoMarcas && listaMarcas.Any())
    {
        <div class="brands-carousel">

            <div class="brands-track">

                <div class="brands-group">
                    @foreach (var marca in listaMarcas)
                    {
                        <div class="brand-item">

                            @if (!string.IsNullOrWhiteSpace(marca.Logo))
                            {
                                <img src="@marca.Logo"
                                     alt="@marca.Nombre" />
                            }

                            @if (string.IsNullOrWhiteSpace(marca.Logo))
                            {
                                <span>@marca.Nombre</span>
                            }

                        </div>
                    }
                </div>

                <div class="brands-group"
                     aria-hidden="true">

                    @foreach (var marca in listaMarcas)
                    {
                        <div class="brand-item">

                            @if (!string.IsNullOrWhiteSpace(marca.Logo))
                            {
                                <img src="@marca.Logo"
                                     alt="" />
                            }

                            @if (string.IsNullOrWhiteSpace(marca.Logo))
                            {
                                <span>@marca.Nombre</span>
                            }

                        </div>
                    }

                </div>

            </div>

        </div>
    }

    @if (!cargandoMarcas && !listaMarcas.Any())
    {
        <p class="brands-status">No hay marcas disponibles.</p>
    }

</section>


<!-- OFERTA RELÁMPAGO -->
<section class="flash-offer-section">

    <div class="flash-card">

        <div class="flash-content">

            <span class="flash-badge">
                OFERTA RELÁMPAGO
            </span>

            <h2 class="flash-title">
                Tecnología premium<br />
                con grandes descuentos
            </h2>

            <p class="flash-description">
                Encuentra productos seleccionados con precios especiales.
                Aprovecha nuestras ofertas disponibles.
            </p>

            <div class="flash-price-box">
                <span class="flash-current-price">
                    Ofertas
                </span>
            </div>

            <a href="/productos"
               class="btn-flash">
                Ver ofertas &rarr;
            </a>

        </div>

        <div class="flash-media">

            <div class="flash-img-wrapper">

                <img src="images/laptop-banner.png"
                     alt="Ofertas NEXOTech" />

            </div>

        </div>

    </div>

</section>


<!-- POR QUÉ NEXO -->
