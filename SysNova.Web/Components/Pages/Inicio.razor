@page "/"
@using SysNova.DTO
@inject HttpClient Http
@* O inyecta tus servicios personalizados si utilizas Dependency Injection directa:
   @inject ICategoriaService CategoriaService
   @inject IProductoService ProductoService 
*@

<PageTitle>NEXOTech - Inicio</PageTitle>

<!-- HERO SECTION -->
<section class="hero-section">
    <div class="hero-content">
        <div class="hero-badge">
            <span>Nueva temporada tech 2026</span>
        </div>

        <h1 class="hero-title">
            Tecnología que<br />
            inspira tu día a día
        </h1>

        <p class="hero-description">
            Descubre las últimas laptops, smartphones y gadgets de las marcas líderes.
            Precios premium, envío rápido y garantía oficial en cada compra.
        </p>

        <div class="hero-actions">
            <a href="/productos" class="btn-primary">Comprar ahora &rarr;</a>
            <a href="/ofertas" class="btn-link">Ver ofertas</a>
        </div>

        <div class="hero-stats">
            <div class="stat-item">
                <h3>50k+</h3>
                <p>Clientes felices</p>
            </div>
            <div class="stat-item">
                <h3>1.2k+</h3>
                <p>Productos</p>
            </div>
            <div class="stat-item">
                <h3>4.9 ★</h3>
                <p>Valoración</p>
            </div>
        </div>
    </div>

    <div class="hero-media">
        <div class="floating-badge top-left">
            <span class="badge-icon">🚚</span>
            <div>
                <strong>Envío express</strong>
                <br /><small>Entrega en 24h</small>
            </div>
        </div>

        <div class="media-card-main">
            <img src="images/laptop-hero.png" alt="Laptop Premium NEXOTech" />
        </div>

        <div class="floating-badge bottom-right">
            <span class="badge-icon">🛡️</span>
            <div>
                <strong>Garantía oficial</strong>
                <br /><small>Hasta 24 meses</small>
            </div>
        </div>
    </div>
</section>

<!-- BANNER PROMO -->
<section class="promo-slider-section">
    <div class="promo-card">
        <button type="button" class="slider-arrow left" aria-label="Anterior">&lsaquo;</button>

        <div class="promo-image-container">
            <img src="images/laptop-banner.png" alt="Audio Premium" />
        </div>

        <div class="promo-content">
            <span>Audio Premium</span>
            <h2>Sonido sin límites, envío gratis</h2>
            <p>Audífonos con cancelación de ruido activa desde $199. Vive cada detalle.</p>
            <a href="/categoria/audio" class="btn-secondary">Explorar audio &rarr;</a>
        </div>

        <button type="button" class="slider-arrow right" aria-label="Siguiente">&rsaquo;</button>
    </div>
</section>

<!-- CATEGORÍAS (LECTURA DE BASE DE DATOS) -->
<section class="categories-section">
    <div class="section-header">
        <span class="section-tag">EXPLORA</span>
        <h2 class="section-title">Categorías de productos</h2>
        <p class="section-subtitle">Encuentra justo lo que buscas navegando por nuestras categorías.</p>
    </div>

    <div class="categories-grid">
        @if (cargandoCategorias)
        {
            <p>Cargando categorías...</p>
        }
        else if (listaCategorias != null && listaCategorias.Any())
        {
            @foreach (var cat in listaCategorias)
            {
                <div class="category-card" @onclick='() => SeleccionarCategoria(cat.CategoriaId)' style="cursor: pointer;">
                    <div class="category-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                    </div>
                    <h3>@cat.Nombre</h3>
                    <p>@ObtenerCantidadProductosPorCategoria(cat.CategoriaId) productos</p>
                </div>
            }
        }
        else
        {
            <p>No se encontraron categorías disponibles.</p>
        }
    </div>
</section>

<!-- PRODUCTOS DESTACADOS (LECTURA DE BASE DE DATOS) -->
<section class="featured-section">
    <div class="section-header">
        <span class="section-tag">LO MÁS DESEADO</span>
        <h2 class="section-title">Productos destacados</h2>
        <p class="section-subtitle">Selección curada de los equipos favoritos de nuestros clientes.</p>
    </div>

    <!-- Filtros dinámicos según Categorías de BD -->
    <div class="filter-pills">
        <button type="button" class="pill-btn @(categoriaIdSeleccionada == 0 ? "active" : "")" @onclick='() => SeleccionarCategoria(0)'>Todos</button>
        @if (listaCategorias != null)
        {
            @foreach (var cat in listaCategorias)
            {
                <button type="button" class="pill-btn @(categoriaIdSeleccionada == cat.CategoriaId ? "active" : "")" @onclick='() => SeleccionarCategoria(cat.CategoriaId)'>
                    @cat.Nombre
                </button>
            }
        }
    </div>

    <!-- Grid de productos -->
    <div class="products-grid">
        @if (cargandoProductos)
        {
            <p>Cargando productos...</p>
        }
        else if (ProductosFiltrados != null && ProductosFiltrados.Any())
        {
            @foreach (var prod in ProductosFiltrados)
            {
                <div class="product-card" @onclick="() => AbrirDetalleProducto(prod)" style="cursor: pointer;">
                    @if (prod.Nuevo)
                    {
                        <span class="product-badge">Nuevo</span>
                    }
                    else if (prod.Destacado)
                    {
                        <span class="product-badge">Top ventas</span>
                    }

                    <div class="product-img-wrapper">
                        <img src="@(string.IsNullOrEmpty(prod.ImagenPrincipal) ? "images/laptop-hero.png" : prod.ImagenPrincipal)" alt="@prod.Nombre" />
                    </div>
                    <div class="product-info">
                        <span class="product-cat">SKU: @prod.CodigoSKU</span>
                        <h3 class="product-name">@prod.Nombre</h3>
                        <div class="product-rating">
                            <span class="star">★</span>
                            <span class="score">4.8</span>
                            <span class="reviews">(Stock: @prod.Stock)</span>
                        </div>
                        <div class="product-price-box">
                            <div class="prices">
                                <span class="current-price">US$ @prod.Precio</span>
                                @if (prod.PrecioAnterior.HasValue)
                                {
                                    <span class="old-price">US$ @prod.PrecioAnterior</span>
                                }
                            </div>
                            @if (prod.PorcentajeDescuento.HasValue && prod.PorcentajeDescuento > 0)
                            {
                                <span class="savings">Ahorras @prod.PorcentajeDescuento%</span>
                            }
                            else
                            {
                                <span class="savings placeholder-space">.</span>
                            }
                        </div>
                    </div>
                    <button type="button" class="btn-add-cart" @onclick:stopPropagation="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z" /></svg>
                        Añadir al carrito
                    </button>
                </div>
            }
        }
        else
        {
            <p>No se encontraron productos en esta categoría.</p>
        }
    </div>

    <!-- Botón ver todo el catálogo -->
    <div class="catalog-action">
        <a href="/productos" class="btn-outline-catalog">Ver todo el catálogo</a>
    </div>
</section>

<!-- BRANDS SECTION -->
<section class="brands-section">
    <span class="brands-tag">MARCAS RECONOCIDAS QUE CONFIÁN EN NOSOTROS</span>
    <div class="brands-logos">
        <span>Sony</span>
        <span>Lenovo</span>
        <span>Logitech</span>
        <span>ASUS</span>
        <span>Xiaomi</span>
        <span>JBL</span>
        <span>Apple</span>
        <span>Samsung</span>
    </div>
</section>

<!-- OFERTA RELÁMPAGO -->
<section class="flash-offer-section">
    <div class="flash-card">
        <div class="flash-content">
            <span class="flash-badge">OFERTA RELÁMPAGO</span>

            <h2 class="flash-title">
                NEXO Sound Max ANC<br />
                con 24% de descuento
            </h2>

            <p class="flash-description">
                Audífonos premium con cancelación de ruido activa y 40h de batería. Solo por tiempo limitado o hasta agotar existencias.
            </p>

            <div class="flash-price-box">
                <span class="flash-current-price">US$ 249</span>
                <span class="flash-old-price">US$ 329</span>
            </div>

            <div class="flash-timer">
                <div class="timer-unit">
                    <span class="number">08</span>
                    <span class="label">HORAS</span>
                </div>
                <div class="timer-unit">
                    <span class="number">57</span>
                    <span class="label">MIN</span>
                </div>
                <div class="timer-unit">
                    <span class="number">51</span>
                    <span class="label">SEC</span>
                </div>
            </div>

            <a href="/producto/nexo-sound-max" class="btn-flash">Aprovechar oferta &rarr;</a>
        </div>

        <div class="flash-media">
            <div class="flash-img-wrapper">
                <img src="images/laptop-banner.png" alt="NEXO Sound Max ANC" />
            </div>
        </div>
    </div>
</section>

