    // =========================================================
    // INICIALIZACIÓN
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        await CargarCategoriasBD();

        await CargarProductosBD();

        await CargarBannersBD();

        await CargarMarcasBD();

        await CargarResenasBD();

        await CargarPreguntasBD();

        await CargarBlogsBD();
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            await AuthState.InicializarAsync();

            if (AuthState.EsCliente)
            {
                clienteIdActualResenas =
                    await ObtenerClienteIdActualResenas();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Error al inicializar sesión en Inicio: {ex.Message}");
        }

        await InvokeAsync(StateHasChanged);
    }


    // =========================================================
    // CATEGORÍAS
    // =========================================================

    private async Task CargarCategoriasBD()
    {
        try
        {
            cargandoCategorias = true;

            var result =
                await Http.GetFromJsonAsync<List<CategoriaDTO>>(
                    "api/categoria");

            if (result != null)
            {
                listaCategorias = result
                    .Where(x => x.Activo)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Error al cargar categorías: {ex.Message}");
        }
        finally
        {
            cargandoCategorias = false;
        }
    }


