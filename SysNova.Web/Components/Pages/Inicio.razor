<!-- MODAL DE DETALLE DE PRODUCTO -->
<ProductoDetalle @bind-mostrarModal="mostrarModalDetalle" Producto="productoSeleccionado" />

@code {
    private bool mostrarModalDetalle = false;
    private SysNova.DTO.ProductoDTO productoSeleccionado = new();
    private int categoriaIdSeleccionada = 0; // 0 significa TODOS

    private bool cargandoCategorias = true;
    private bool cargandoProductos = true;

    private List<SysNova.DTO.CategoriaDTO> listaCategorias = new();
    private List<SysNova.DTO.ProductoDTO> listaProductos = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarCategoriasBD();
        await CargarProductosBD();
    }

    private async Task CargarCategoriasBD()
    {
        try
        {
            cargandoCategorias = true;
            // Ajusta la ruta a la URL de tu API
            var result = await Http.GetFromJsonAsync<List<SysNova.DTO.CategoriaDTO>>("api/categoria");
            if (result != null)
            {
                listaCategorias = result;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar categorías: {ex.Message}");
        }
        finally
        {
            cargandoCategorias = false;
        }
    }

    private async Task CargarProductosBD()
    {
        try
        {
            cargandoProductos = true;
            // Ajusta la ruta a la URL de tu API
            var result = await Http.GetFromJsonAsync<List<SysNova.DTO.ProductoDTO>>("api/producto");
            if (result != null)
            {
                listaProductos = result;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar productos: {ex.Message}");
        }
        finally
        {
            cargandoProductos = false;
        }
    }

    private int ObtenerCantidadProductosPorCategoria(int categoriaId)
    {
        return listaProductos?.Count(p => p.CategoriaId == categoriaId) ?? 0;
    }

    private IEnumerable<SysNova.DTO.ProductoDTO> ProductosFiltrados =>
        categoriaIdSeleccionada == 0
            ? listaProductos
            : listaProductos.Where(p => p.CategoriaId == categoriaIdSeleccionada);

    private void SeleccionarCategoria(int categoriaId)
    {
        categoriaIdSeleccionada = categoriaId;
    }

    private void AbrirDetalleProducto(SysNova.DTO.ProductoDTO producto)
    {
        productoSeleccionado = producto;
        mostrarModalDetalle = true;
    }
}