<!-- TESTIMONIOS - BASE DE DATOS -->
<section id="resenas" class="testimonials-section">

    <div class="section-header">

        <span class="section-tag">
            TESTIMONIOS
        </span>

        <h2 class="section-title">
            Lo que dicen nuestros clientes
        </h2>

        <p class="section-subtitle">
            Opiniones reales registradas en nuestra plataforma.
        </p>

        @if (AuthState.EsCliente)
        {
            <div class="mt-3">

                <button type="button"
                        class="btn-primary"
                        style="position:relative; z-index:50; pointer-events:auto;"
                        @onclick="AbrirModalResenas">
                    ⭐ Agregar reseña
                </button>

            </div>
        }

    </div>


    <div class="testimonials-grid">

        @if (cargandoResenas)
        {
            <p>Cargando reseñas...</p>
        }
        else if (listaResenas.Any())
        {
            @foreach (var resena in listaResenas)
            {
                <div class="testimonial-card">

                    <div class="testimonial-stars"
                         aria-label="@($"{resena.Calificacion} de 5 estrellas")">

                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= resena.Calificacion)
                            {
                                <span class="testimonial-star filled">★</span>
                            }
                            else
                            {
                                <span class="testimonial-star empty">★</span>
                            }
                        }

                    </div>

                    <p class="testimonial-text">
                        "@resena.Comentario"
                    </p>

                    <div class="testimonial-user"
                         style="display:flex;align-items:center;gap:.8rem;">

                        <div class="user-avatar">
                            ★
                        </div>

                        <div class="user-info"
                             style="flex:1;min-width:0;">

                            <h4>
                                @ObtenerNombreClienteResena(resena)
                            </h4>

                            <p>
                                @ObtenerNombreProductoResena(resena.ProductoId)
                            </p>

                        </div>

                        @if (EsMiResena(resena))
                        {
                            <div style="display:flex;align-items:center;gap:.4rem;">

                                <button type="button"
                                        title="Editar mi reseña"
                                        aria-label="Editar mi reseña"
                                        @onclick="() => EditarMiResena(resena)"
                                        style="
                                                                                            width:34px;
                                                                                            height:34px;
                                                                                            display:flex;
                                                                                            align-items:center;
                                                                                            justify-content:center;
                                                                                            border-radius:9px;
                                                                                            border:1px solid rgba(59,130,246,.45);
                                                                                            background:rgba(37,99,235,.12);
                                                                                            color:#60a5fa;
                                                                                            cursor:pointer;">
                                    ✏️
                                </button>

                                <button type="button"
                                        title="Eliminar mi reseña"
                                        aria-label="Eliminar mi reseña"
                                        @onclick="() => EliminarMiResena(resena)"
                                        style="
                                                                                            width:34px;
                                                                                            height:34px;
                                                                                            display:flex;
                                                                                            align-items:center;
                                                                                            justify-content:center;
                                                                                            border-radius:9px;
                                                                                            border:1px solid rgba(239,68,68,.45);
                                                                                            background:rgba(220,38,38,.12);
                                                                                            color:#f87171;
                                                                                            cursor:pointer;">
                                    🗑️
                                </button>

                            </div>
                        }

                    </div>

                </div>
            }
        }
        else
        {
            <p>
                No hay reseñas disponibles.
            </p>
        }

    </div>

</section>


<!-- MODAL DE RESEÑAS DEL CLIENTE -->
<Resena @ref="resenaModal"
        Productos="listaProductos"
        OnResenaGuardada="CargarResenasBD" />


<!-- PREGUNTAS FRECUENTES - BASE DE DATOS -->
<section class="faq-section">

    <div class="section-header">

        <span class="section-tag">
            AYUDA
        </span>

        <h2 class="section-title">
            Preguntas frecuentes
        </h2>

        <p class="section-subtitle">
            Resolvemos las dudas más comunes sobre tu compra.
        </p>

    </div>


    <div class="faq-container">

        @if (cargandoPreguntas)
        {
            <p>Cargando preguntas frecuentes...</p>
        }
        else if (listaPreguntas.Any())
        {
            @foreach (var pregunta in listaPreguntas)
            {
                <details class="faq-item">

                    <summary class="faq-question">

                        @pregunta.Pregunta

                        <span class="faq-icon"></span>

                    </summary>

                    <div class="faq-answer">

                        <p>
                            @pregunta.Respuesta
                        </p>

                    </div>

                </details>
            }
        }
        else
        {
            <p>
                No hay preguntas frecuentes disponibles.
            </p>
        }

    </div>

</section>


<!-- BLOG - BASE DE DATOS -->
<section class="blog-section">

    <div class="blog-header">

        <div class="blog-header-left">

            <span class="section-tag">
                BLOG DE TECNOLOGÍA
            </span>

            <h2 class="section-title">
                Novedades y guías tech
            </h2>

            <p class="section-subtitle">
                Consejos, análisis y tendencias para sacarle el máximo a tus dispositivos.
            </p>

        </div>

        <a href="/blog"
           class="btn-outline-blog">
            Ver todos los artículos
        </a>

    </div>


    <div class="blog-grid">

        @if (cargandoBlogs)
        {
            <p>Cargando artículos...</p>
        }
        else if (listaBlogs.Any())
        {
            @foreach (var blog in listaBlogs)
            {
                <article class="blog-card">

                    <div class="blog-img-wrapper">

                        <img src="@blog.Imagen"
                             alt="@blog.Titulo" />

                    </div>


                    <div class="blog-content">

                        <div class="blog-meta">

                            <span>
                                @blog.FechaPublicacion.ToString("dd MMM yyyy")
                            </span>

                            <span class="meta-dot">
                                •
                            </span>

                            <span>
                                @blog.Visitas visitas
                            </span>

                        </div>


                        <h3 class="blog-card-title">
                            @blog.Titulo
                        </h3>


                        <p class="blog-excerpt">
                            @blog.Resumen
                        </p>


                        <a href="/blog/@blog.BlogId"
                           class="blog-link">
                            Leer más &rarr;
                        </a>

                    </div>

                </article>
            }
        }
        else
