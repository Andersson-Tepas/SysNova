        return listaProductos?
            .Count(p => p.CategoriaId == categoriaId) ?? 0;
    }


    private IEnumerable<ProductoDTO> ProductosFiltrados =>
        categoriaIdSeleccionada == 0
            ? listaProductos
            : listaProductos.Where(
                p => p.CategoriaId == categoriaIdSeleccionada);


    // =========================================================
    // FILTRO CATEGORÍA
    // =========================================================

    private void SeleccionarCategoria(int categoriaId)
    {
        categoriaIdSeleccionada = categoriaId;
    }


    // =========================================================
    // DETALLE PRODUCTO
    // =========================================================

    private void AbrirDetalleProducto(
        ProductoDTO producto)
    {
        productoSeleccionado = producto;

        mostrarModalDetalle = true;
    }


    // =========================================================
    // AGREGAR AL CARRITO DESDE LA TARJETA
    // =========================================================

    private async Task AgregarAlCarrito(
        ProductoDTO producto)
    {
        if (producto.Stock <= 0)
            return;

        // AuthState usa localStorage, por eso lo consultamos
        // cuando el usuario hace clic.
        await AuthState.InicializarAsync();

        // El administrador no compra desde la tienda.
        if (AuthState.EsAdministrador)
            return;

        CarritoState.AgregarProducto(
            producto,
            1);

        // Después de agregar, abrimos el drawer del carrito
        // para que el usuario vea inmediatamente lo añadido.
        CarritoState.SolicitarAbrirCarrito();
    }


    // =========================================================
    // MODAL DE RESEÑAS
    // =========================================================

    private async Task AbrirModalResenas()
    {
        if (resenaModal == null)
        {
            Console.WriteLine(
                "No se pudo obtener la referencia al componente Resena.");
            return;
        }

        await resenaModal.AbrirAsync();
    }


    private bool EsMiResena(
        ResenaDTO resena)
    {
        return AuthState.EsCliente &&
               clienteIdActualResenas > 0 &&
               resena.ClienteId == clienteIdActualResenas;
    }


    private string ObtenerNombreClienteResena(
        ResenaDTO resena)
    {
        if (EsMiResena(resena))
        {
            if (!string.IsNullOrWhiteSpace(AuthState.Nombre))
                return AuthState.Nombre;

            if (!string.IsNullOrWhiteSpace(AuthState.Correo))
                return AuthState.Correo;
        }

        return "Cliente verificado";
    }


    private async Task EditarMiResena(
        ResenaDTO resena)
    {
        if (!EsMiResena(resena) ||
            resenaModal == null)
        {
            return;
        }

        await resenaModal.AbrirEditarAsync(
            resena.ResenaId);
    }


    private async Task EliminarMiResena(
        ResenaDTO resena)
    {
        if (!EsMiResena(resena) ||
            resenaModal == null)
        {
            return;
        }

        await resenaModal.EliminarAsync(
            resena.ResenaId);
    }


    private async Task<int> ObtenerClienteIdActualResenas()
    {
        var token =
            await JS.InvokeAsync<string?>(
                "localStorage.getItem",
                "authToken");

        if (string.IsNullOrWhiteSpace(token))
            return 0;

        try
        {
            var partes =
                token.Split('.');

            if (partes.Length != 3)
                return 0;

            var payload =
                partes[1]
                    .Replace('-', '+')
                    .Replace('_', '/');

            switch (payload.Length % 4)
            {
                case 2:
                    payload += "==";
                    break;

                case 3:
                    payload += "=";
                    break;
            }

            var bytes =
                Convert.FromBase64String(
                    payload);

            var json =
                Encoding.UTF8.GetString(
                    bytes);

            using var documento =
                JsonDocument.Parse(
                    json);

            var root =
                documento.RootElement;

            var idTexto =
                ObtenerClaimInicio(
                    root,
                    "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier")
                ?? ObtenerClaimInicio(
                    root,
                    "nameid")
                ?? ObtenerClaimInicio(
                    root,
                    "sub");

            return int.TryParse(
                idTexto,
                out var id)
                    ? id
                    : 0;
        }
        catch
        {
            return 0;
        }
    }


    private static string? ObtenerClaimInicio(
        JsonElement root,
        string nombre)
    {
        if (!root.TryGetProperty(
            nombre,
            out var valor))
        {
            return null;
        }

        if (valor.ValueKind ==
            JsonValueKind.String)
        {
            return valor.GetString();
        }

        if (valor.ValueKind ==
            JsonValueKind.Number)
        {
            return valor.GetRawText();
        }

        return null;
    }


    private string ObtenerNombreProductoResena(
        int productoId)
    {
        return listaProductos
            .FirstOrDefault(
                p => p.ProductoId == productoId)
            ?.Nombre
            ?? "Producto";
    }

