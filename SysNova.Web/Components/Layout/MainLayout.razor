@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Routing
@using SysNova.DTO
@using SysNova.Web.Components.Pages
@using SysNova.Web.Services

@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject AuthStateService AuthState
@inject CarritoService CarritoState

@implements IDisposable

<div class="sn-layout">

    <header class="sn-header">

        <!-- 1. TOP BAR -->
        <div class="sn-topbar">
            <div class="sn-container sn-topbar-content">

                <div class="sn-topbar-message">
                    <span>⚡</span>
                    <span>
                        Envío gratis en compras superiores a $99 ·
                        <strong>Garantía oficial</strong>
                    </span>
                </div>

                <div class="sn-topbar-links">
                    <a href="#rastrea">Rastrea tu pedido</a>
                    <a href="#soporte">Ayuda &amp; Soporte</a>
                </div>

            </div>
        </div>


        <!-- 2. NAVBAR NEGRO PRINCIPAL -->
        <div class="sn-navbar">

            <div class="sn-container sn-navbar-content">

                <!-- LOGO -->
                <NavLink href="/"
                         Match="NavLinkMatch.All"
                         class="sn-logo">

                    <div class="sn-logo-badge">
                        <span>⚡</span>
                    </div>

                    <span class="sn-logo-text">
                        NEXO<span>Tech</span>
                    </span>

                </NavLink>


                <!-- BUSCADOR DESKTOP -->
                @if (!AuthState.EsAdministrador)
                {
                    <div class="sn-search sn-desktop-search">

                        <span class="sn-search-icon">
                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2">
                                <circle cx="11"
                                        cy="11"
                                        r="7">
                                </circle>

                                <path d="m20 20-3.5-3.5">
                                </path>
                            </svg>
                        </span>

                        <input type="search"
                               placeholder="Busca laptops, audífonos, smartphones..."
                               aria-label="Buscar productos" />

                    </div>
                }


                <!-- MENÚ DE NAVEGACIÓN -->
                <nav class="sn-nav-menu-inline">

                    @* =====================================================
                       PÚBLICO / CLIENTE
                       ===================================================== *@
                    @if (!AuthState.EsAdministrador)
                    {
                        <NavLink href="/"
                                 Match="NavLinkMatch.All"
                                 class="sn-nav-link">
                            Inicio
                        </NavLink>

                        <NavLink href="/categorias"
                                 class="sn-nav-link">
                            Categorías
                        </NavLink>

                        <NavLink href="/productos"
                                 class="sn-nav-link">
                            Productos
                        </NavLink>

                        <NavLink href="/ofertas"
                                 class="sn-nav-link">
                            Ofertas
                        </NavLink>

                        <NavLink href="/blog"
                                 class="sn-nav-link">
                            Blog
                        </NavLink>

                        <NavLink href="/#contacto"
                                 class="sn-nav-link">
                            Contacto
                        </NavLink>

                        @if (AuthState.EsCliente)
                        {
                            <NavLink href="/pedidos"
                                     class="sn-nav-link sn-nav-client">
                                Mis pedidos
                            </NavLink>
                        }
                    }


                    @* =====================================================
                       ADMINISTRADOR
                       ===================================================== *@
                    @if (AuthState.EsAdministrador)
                    {
                        <NavLink href="/"
                                 Match="NavLinkMatch.All"
                                 class="sn-nav-link">
                            Inicio
                        </NavLink>

                        <NavLink href="/productos"
                                 class="sn-nav-link">
                            Productos
                        </NavLink>

                        <NavLink href="/pedidos"
                                 class="sn-nav-link">
                            Pedidos
                        </NavLink>

                    }

                </nav>


                <!-- ACCIONES DERECHA -->
                <div class="sn-actions">

                    @if (AuthState.EsAdministrador)
                    {
                        <span class="sn-role-badge sn-role-admin">
                            ADMIN
                        </span>
                    }


                    <!-- PERFIL -->
                    <button type="button"
                            class="sn-action-button sn-user-btn"
                            aria-label="Mi cuenta"
                            title="Mi cuenta"
                            @onclick="AbrirPerfil">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2">

                            <path d="M20 21a8 8 0 0 0-16 0">
                            </path>

                            <circle cx="12"
                                    cy="7"
                                    r="4">
                            </circle>

                        </svg>

                    </button>


                    <!-- CARRITO: PÚBLICO Y CLIENTE -->
                    @if (!AuthState.EsAdministrador)
                    {
                        <button type="button"
                                class="sn-action-button sn-cart-button"
                                aria-label="Carrito de compras"
                                title="Carrito"
                                @onclick="AbrirCarrito">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2">

                                <circle cx="9"
                                        cy="20"
                                        r="1">
                                </circle>

                                <circle cx="19"
                                        cy="20"
                                        r="1">
                                </circle>

                                <path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 2-1.6L21 8H6">
                                </path>

                            </svg>

                            @if (cantidadTotal > 0)
                            {
                                <span class="sn-cart-count">
                                    @cantidadTotal
                                </span>
                            }

                        </button>
                    }

                </div>

            </div>


            <!-- BUSCADOR MÓVIL: NO SE MUESTRA EN ADMIN -->
            @if (!AuthState.EsAdministrador)
            {
                <div class="sn-mobile-search-row">

                    <div class="sn-container">

                        <div class="sn-search">

                            <span class="sn-search-icon">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2">

                                    <circle cx="11"
                                            cy="11"
                                            r="7">
                                    </circle>

                                    <path d="m20 20-3.5-3.5">
                                    </path>

                                </svg>

                            </span>

                            <input type="search"
                                   placeholder="Buscar productos..."
                                   aria-label="Buscar productos" />

                        </div>

                    </div>

                </div>
            }

        </div>

    </header>


    <!-- CONTENIDO -->
    <main class="sn-main-content">
        @Body
    </main>


    <!-- FOOTER -->
    <Footer />


    <!-- CARRITO -->
    @if (!AuthState.EsAdministrador)
    {
        <Carrito @bind-IsOpen="isCartOpen" />
    }


    <!-- PERFIL -->
    <ProfileDrawer @bind-IsOpen="isProfileOpen"
                   UserName="@usuarioNombre"
                   UserEmail="@usuarioEmail"
                   IsAdmin="@AuthState.EsAdministrador"
                   IsClient="@AuthState.EsCliente"
                   RecentOrdersCount="@pedidosCount"
                   OnLogout="CerrarSesion" />


    <div id="blazor-error-ui">

        An unhandled error has occurred.

        <a href="" class="reload">
            Reload
        </a>

        <a class="dismiss">
            🗙
        </a>

    </div>

</div>


@code {

    private bool isCartOpen = false;

    private bool isProfileOpen = false;
    private string usuarioNombre = string.Empty;

    private string usuarioEmail = string.Empty;

    private int pedidosCount = 0;


    private int cantidadTotal =>
        CarritoState.CantidadTotal;


    protected override void OnInitialized()
    {
        CarritoState.OnChange +=
            ActualizarCarrito;
    }


    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
            return;

        await CargarDatosUsuario();

        await InvokeAsync(
            StateHasChanged);
    }


    private void ActualizarCarrito()
    {
        _ = InvokeAsync(
            StateHasChanged);
    }


    private async Task CargarDatosUsuario()
    {
        try
        {
            await AuthState.InicializarAsync();

            usuarioEmail =
                AuthState.Correo;

            usuarioNombre =
                AuthState.Nombre;

            if (string.IsNullOrWhiteSpace(
                    usuarioNombre) &&
                !string.IsNullOrWhiteSpace(
                    usuarioEmail))
            {
                usuarioNombre =
                    usuarioEmail.Split('@')[0];
            }
        }
        catch
        {
            usuarioEmail =
                string.Empty;

            usuarioNombre =
                string.Empty;
        }
    }


    private void AbrirCarrito()
    {
        if (AuthState.EsAdministrador)
            return;

        isCartOpen = true;
    }


    private async Task AbrirPerfil()
    {
        await AuthState.InicializarAsync();

        usuarioEmail =
            AuthState.Correo;

        usuarioNombre =
            AuthState.Nombre;

        if (!AuthState.EstaAutenticado)
        {
            Navigation.NavigateTo(
                "/login");

            return;
        }

        isProfileOpen = true;
    }


    private void CerrarSesion()
    {
        isProfileOpen = false;
        isCartOpen = false;

        usuarioNombre =
            string.Empty;

        usuarioEmail =
            string.Empty;

        pedidosCount = 0;
    }


    public void Dispose()
    {
        CarritoState.OnChange -=
            ActualizarCarrito;
    }
}
