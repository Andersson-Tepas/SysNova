@inject NavigationManager Navigation
@inject AuthStateService AuthState
@inject IJSRuntime JS
@using SysNova.Web.Services
@using Microsoft.JSInterop
@implements IAsyncDisposable

<div class="profile-backdrop @(IsOpen ? "show" : "")"
     @onclick="Close"
     @onwheel:preventDefault="true"
     @ontouchmove:preventDefault="true"
     style="
        overscroll-behavior:none;
        touch-action:none;">
</div>

<aside class="profile-drawer @(IsOpen ? "is-open" : "")"
       @onwheel:preventDefault="true"
       @ontouchmove:preventDefault="true"
       style="
          overflow:hidden !important;
          overscroll-behavior:none;
          touch-action:none;">

    <!-- Header -->
    <div class="profile-header">

        <div>
            <span class="profile-subtitle">
                @(IsAdmin
                                ? "ADMINISTRACIÓN"
                                : "MI CUENTA")
            </span>

            <h2 class="profile-title">
                @(IsAdmin
                                ? "Panel NEXO"
                                : "Perfil NEXO")
            </h2>
        </div>

        <button type="button"
                class="btn-icon-close"
                @onclick="Close"
                aria-label="Cerrar">

            <svg width="20"
                 height="20"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2">

                <line x1="18"
                      y1="6"
                      x2="6"
                      y2="18">
                </line>

                <line x1="6"
                      y1="6"
                      x2="18"
                      y2="18">
                </line>

            </svg>

        </button>

    </div>


    <!-- Body -->
    <div class="profile-body"
         style="
            overflow:hidden !important;
            overscroll-behavior:none;">

        <!-- Tarjeta de bienvenida -->
        <div class="user-hero-card">

            <div class="user-avatar-circle">
                <span>
                    @(string.IsNullOrWhiteSpace(UserName)
                                        ? "U"
                                        : UserName.Substring(0, 1).ToUpper())
                </span>
            </div>

            <div class="profile-hero-heading">

                <div>
                    <h3 class="user-greeting">
                        Hola,
                        @(string.IsNullOrWhiteSpace(UserName)
                                                ? "Usuario"
                                                : UserName)
                    </h3>

                    <p class="user-subtext">
                        @(IsAdmin
                                                ? "Gestiona el contenido y las operaciones de NEXO Tech."
                                                : "Tu espacio personal en NEXO Tech.")
                    </p>
                </div>

                <span class="profile-role-pill @(IsAdmin ? "admin" : "client")">
                    @(IsAdmin ? "ADMIN" : "CLIENTE")
                </span>

            </div>

        </div>


        <!-- Información de cuenta -->
        <div class="profile-info-list">

            <div class="info-card">

                <div class="info-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2">

                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2">
                        </path>

                        <circle cx="12"
                                cy="7"
                                r="4">
                        </circle>

                    </svg>

                </div>

                <div class="info-details">

                    <span class="info-label">
                        Correo de la cuenta
                    </span>

                    <span class="info-value">
                        @(string.IsNullOrWhiteSpace(UserEmail)
                                                ? "Sin registrar"
                                                : UserEmail)
                    </span>

                </div>

            </div>

        </div>


        @if (IsAdmin)
        {
            <!-- =================================================
                 ACCESOS ADMINISTRATIVOS
                 ================================================= -->
            <section class="profile-shortcuts-section">

                <div class="profile-section-heading">
                    <span>ACCESOS ADMINISTRATIVOS</span>
                    <small>Gestión rápida</small>
                </div>

                <div class="profile-shortcuts-grid">

                    <button type="button"
                            class="profile-shortcut"
                            @onclick='() => NavegarA("/pedidos")'>
                        <span class="profile-shortcut-icon">📦</span>
                        <span class="profile-shortcut-text">
                            <strong>Pedidos</strong>
                            <small>Gestionar ventas</small>
                        </span>
                    </button>

                    <button type="button"
                            class="profile-shortcut"
                            @onclick='() => NavegarA("/productos")'>
                        <span class="profile-shortcut-icon">💻</span>
                        <span class="profile-shortcut-text">
                            <strong>Productos</strong>
                            <small>Catálogo y stock</small>
                        </span>
                    </button>

                    <button type="button"
                            class="profile-shortcut"
                            @onclick='() => NavegarA("/categorias")'>
                        <span class="profile-shortcut-icon">🗂️</span>
                        <span class="profile-shortcut-text">
                            <strong>Categorías</strong>
                            <small>Organizar catálogo</small>
                        </span>
                    </button>

                    <button type="button"
                            class="profile-shortcut"
                            @onclick='() => NavegarA("/marcas")'>
                        <span class="profile-shortcut-icon">🏷️</span>
                        <span class="profile-shortcut-text">
                            <strong>Marcas</strong>
                            <small>Fabricantes</small>
                        </span>
                    </button>

                    <button type="button"
                            class="profile-shortcut"
                            @onclick='() => NavegarA("/banners")'>
                        <span class="profile-shortcut-icon">🖼️</span>
                        <span class="profile-shortcut-text">
                            <strong>Banners</strong>
                            <small>Promociones</small>
                        </span>
                    </button>

                    <button type="button"
                            class="profile-shortcut"
                            @onclick="IrAResenasInicio">
                        <span class="profile-shortcut-icon">⭐</span>
                        <span class="profile-shortcut-text">
                            <strong>Reseñas</strong>
                            <small>Ver testimonios del inicio</small>
                        </span>
                    </button>

                    <button type="button"
                            class="profile-shortcut"
                            @onclick='() => NavegarA("/preguntasfrecuentes")'>
                        <span class="profile-shortcut-icon">❓</span>
                        <span class="profile-shortcut-text">
                            <strong>Preguntas</strong>
                            <small>FAQ del sitio</small>
                        </span>
                    </button>

                    <button type="button"
                            class="profile-shortcut"
                            @onclick='() => NavegarA("/blog")'>
                        <span class="profile-shortcut-icon">📰</span>
                        <span class="profile-shortcut-text">
                            <strong>Blog</strong>
                            <small>Contenido</small>
                        </span>
                    </button>

                </div>

            </section>
        }
        else
        {
            <!-- =================================================
                 ACCESOS DEL CLIENTE
                 ================================================= -->
            <section class="profile-shortcuts-section">

                <div class="profile-section-heading">
                    <span>MI CUENTA</span>
                    <small>Accesos rápidos</small>
                </div>

                <div class="profile-shortcuts-grid client-grid">

                    <button type="button"
                            class="profile-shortcut"
                            @onclick='() => NavegarA("/pedidos")'>
                        <span class="profile-shortcut-icon">📦</span>
                        <span class="profile-shortcut-text">
                            <strong>Mis pedidos</strong>
                            <small>
                                @RecentOrdersCount realizados
                            </small>
                        </span>
                    </button>

                    <button type="button"
                            class="profile-shortcut"
                            @onclick='() => NavegarA("/favoritos")'>
                        <span class="profile-shortcut-icon">♥</span>
                        <span class="profile-shortcut-text">
                            <strong>Favoritos</strong>
                            <small>Lista de deseos</small>
                        </span>
                    </button>

                    <button type="button"
                            class="profile-shortcut"
                            @onclick='() => NavegarA("/productos")'>
                        <span class="profile-shortcut-icon">🛍️</span>
                        <span class="profile-shortcut-text">
                            <strong>Productos</strong>
                            <small>Seguir comprando</small>
                        </span>
                    </button>

                    <button type="button"
                            class="profile-shortcut"
                            @onclick="IrAResenasInicio">
                        <span class="profile-shortcut-icon">⭐</span>
                        <span class="profile-shortcut-text">
                            <strong>Reseñas</strong>
                            <small>Ir a testimonios</small>
                        </span>
                    </button>

                </div>

            </section>
        }


        <!-- Estado -->
        <div class="info-card info-card-status">

            <div class="info-icon-check">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2.5">

                    <polyline points="20 6 9 17 4 12">
                    </polyline>

                </svg>

            </div>

            <span class="status-text">
                @(IsAdmin
                                ? "Cuenta Administrador NEXO activa"
                                : "Cuenta Cliente NEXO activa")
            </span>

        </div>

    </div>


    <!-- Footer / Cerrar sesión -->
    <div class="profile-footer">

        <button type="button"
                class="btn-logout"
                @onclick="HandleLogout">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2">

                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4">
                </path>

                <polyline points="16 17 21 12 16 7">
                </polyline>

                <line x1="21"
                      y1="12"
                      x2="9"
                      y2="12">
                </line>

            </svg>

            Cerrar sesión

        </button>

    </div>

</aside>


@code {

    private bool? ultimoEstadoScrollBloqueado;

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }


    [Parameter]
    public string UserName { get; set; } =
        string.Empty;

    [Parameter]
    public string UserEmail { get; set; } =
        string.Empty;

    [Parameter]
    public bool IsAdmin { get; set; } =
        false;

    [Parameter]
    public bool IsClient { get; set; } =
        false;

    [Parameter]
    public int RecentOrdersCount { get; set; } =
        0;

    [Parameter]
    public EventCallback OnLogout { get; set; }


    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        // Al cargar la página por primera vez, el drawer está cerrado.
        // NO llamamos a JavaScript todavía porque no hay nada que
        // desbloquear y así evitamos errores si ui-scroll.js aún
        // no terminó de cargarse.
        if (ultimoEstadoScrollBloqueado is null)
        {
            ultimoEstadoScrollBloqueado = IsOpen;

            if (!IsOpen)
                return;
        }

        if (ultimoEstadoScrollBloqueado == IsOpen)
            return;

        try
        {
            if (IsOpen)
            {
                await JS.InvokeVoidAsync(
                    "nexoUiScroll.lock");
            }
            else
            {
                await JS.InvokeVoidAsync(
                    "nexoUiScroll.unlock");
            }

            ultimoEstadoScrollBloqueado = IsOpen;
        }
        catch (JSException ex)
        {
            Console.WriteLine(
                $"No se pudo cambiar el bloqueo de scroll: {ex.Message}");
        }
        catch (JSDisconnectedException)
        {
            // El circuito de Blazor ya se cerró.
        }
    }


    private async Task Close()
    {
        IsOpen = false;

        await IsOpenChanged.InvokeAsync(
            IsOpen);
    }


    private async Task NavegarA(
        string ruta)
    {
        await Close();

        Navigation.NavigateTo(
            ruta);
    }


    private async Task IrAResenasInicio()
    {
        await Close();

        // Navega al Inicio y posiciona el navegador
        // exactamente en la sección de reseñas.
        Navigation.NavigateTo(
            "/#resenas",
            forceLoad: true);
    }


    private async Task HandleLogout()
    {
        await Close();

        try
        {
            await AuthState.CerrarSesionAsync();
        }
        catch
        {
            // Evita que un error de localStorage
            // impida cerrar visualmente la sesión.
        }

        if (OnLogout.HasDelegate)
        {
            await OnLogout.InvokeAsync();
        }

        Navigation.NavigateTo(
            "/",
            forceLoad: true);
    }

    public async ValueTask DisposeAsync()
    {
        // Solo intentamos desbloquear si alguna vez
        // llegamos a abrir el drawer.
        if (ultimoEstadoScrollBloqueado != true)
            return;

        try
        {
            await JS.InvokeVoidAsync(
                "nexoUiScroll.unlock");
        }
        catch
        {
            // No bloqueamos la destrucción del componente
            // si el navegador/circuito ya no está disponible.
        }
    }

}
