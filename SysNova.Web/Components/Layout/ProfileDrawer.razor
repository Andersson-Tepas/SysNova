@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="profile-backdrop @(IsOpen ? "show" : "")" @onclick="Close"></div>

<aside class="profile-drawer @(IsOpen ? "is-open" : "")">

    <!-- Header -->
    <div class="profile-header">
        <div>
            <span class="profile-subtitle">MI CUENTA</span>
            <h2 class="profile-title">Perfil NEXO</h2>
        </div>
        <button type="button" class="btn-icon-close" @onclick="Close" aria-label="Cerrar">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
    </div>

    <!-- Body -->
    <div class="profile-body">

        <!-- Tarjeta de Bienvenida -->
        <div class="user-hero-card">
            <div class="user-avatar-circle">
                <span>@(string.IsNullOrWhiteSpace(UserName) ? "U" : UserName.Substring(0, 1).ToUpper())</span>
            </div>
            <h3 class="user-greeting">Hola, @(string.IsNullOrWhiteSpace(UserName) ? "Usuario" : UserName)</h3>
            <p class="user-subtext">Tu espacio personal en NEXO Tech.</p>
        </div>

        <!-- Lista de Navegación / Accesos Directos -->
        <div class="profile-info-list">

            <!-- Correo -->
            <div class="info-card">
                <div class="info-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                </div>
                <div class="info-details">
                    <span class="info-label">Correo de la cuenta</span>
                    <span class="info-value">@(string.IsNullOrWhiteSpace(UserEmail) ? "Sin registrar" : UserEmail)</span>
                </div>
            </div>

            <!-- Opción: Mis Pedidos / Panel de Pedidos -->
            <div class="info-card info-card-clickable" @onclick='() => NavegarA("/pedidos")' style="cursor: pointer;">
                <div class="info-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                    </svg>
                </div>
                <div class="info-details">
                    <span class="info-label">@(IsAdmin ? "Gestión Global" : "Mis compras")</span>
                    <span class="info-value">@(IsAdmin ? "Administrar Pedidos" : $"{RecentOrdersCount} pedidos realizados")</span>
                </div>
            </div>

            <!-- Opción: Mis Favoritos -->
            <div class="info-card info-card-clickable" @onclick='() => NavegarA("/favoritos")' style="cursor: pointer;">
                <div class="info-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 3.8 3 5.5l7 7Z"></path>
                    </svg>
                </div>
                <div class="info-details">
                    <span class="info-label">Lista de Deseos</span>
                    <span class="info-value">Mis Favoritos</span>
                </div>
            </div>

            <!-- Estado de la Cuenta -->
            <div class="info-card info-card-status">
                <div class="info-icon-check">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                </div>
                <span class="status-text">@(IsAdmin ? "Cuenta Admin NEXO Active" : "Cuenta NEXO activa")</span>
            </div>

        </div>
    </div>

    <!-- Footer / Cerrar Sesión -->
    <div class="profile-footer">
        <button type="button" class="btn-logout" @onclick="HandleLogout">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            Cerrar sesión
        </button>
    </div>

</aside>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter] public string UserName { get; set; } = string.Empty;
    [Parameter] public string UserEmail { get; set; } = string.Empty;
    [Parameter] public bool IsAdmin { get; set; } = false;
    [Parameter] public int RecentOrdersCount { get; set; } = 0;

    [Parameter] public EventCallback OnLogout { get; set; }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }

    private async Task NavegarA(string ruta)
    {
        await Close();
        Navigation.NavigateTo(ruta);
    }

    private async Task HandleLogout()
    {
        await Close();

        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", "userEmail");
            await JS.InvokeVoidAsync("localStorage.removeItem", "userName");
            await JS.InvokeVoidAsync("localStorage.removeItem", "userRole");
            await JS.InvokeVoidAsync("localStorage.removeItem", "authToken");
        }
        catch { }

        if (OnLogout.HasDelegate)
        {
            await OnLogout.InvokeAsync();
        }

        Navigation.NavigateTo("/", forceLoad: true);
    }
}